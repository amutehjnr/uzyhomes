<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Luxury Bedding Collection — Bedsheets, Duvets, Pillows, Towels, Throw Blankets, and Robes at UZYHOMES">
    <title>Bedding Collection | UZYHOMES</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">

    <style>
        :root {
            --ivory: #FAF9F7;
            --stone: #F5F3F0;
            --sand: #E8E4DD;
            --charcoal: #2D2D2D;
            --grey: #777777;
            --clay: #A68A6F;
            --linen: #D9D1C7;
            --font-serif: 'Playfair Display', Georgia, serif;
            --font-sans: 'Inter', sans-serif;
            --ease: all 0.3s cubic-bezier(0.4,0,0.2,1);
        }

        body { font-family: var(--font-sans); font-weight: 300; color: var(--charcoal); background: var(--ivory); }

        .page-hero {
            padding: 120px 0 60px;
            text-align: center;
            background: linear-gradient(to bottom, var(--stone), var(--ivory));
        }
        .page-hero .eyebrow {
            font-size: 0.72rem; letter-spacing: 3px; text-transform: uppercase;
            color: var(--grey); margin-bottom: 14px; display: block;
        }
        .page-hero h1 {
            font-family: var(--font-serif); font-size: clamp(2rem, 4.5vw, 3.2rem);
            font-weight: 400; max-width: 640px; margin: 0 auto 14px; line-height: 1.18;
        }
        .page-hero .subtitle {
            font-size: 1rem; color: var(--grey); max-width: 440px; margin: 0 auto;
        }

        /* Category Tabs - Same as collections.ejs filter-bar */
        .category-tabs {
            background: white;
            border-bottom: 1px solid rgba(0,0,0,0.06);
            position: sticky;
            top: 70px;
            z-index: 99;
            overflow-x: auto;
            scrollbar-width: none;
        }
        .category-tabs::-webkit-scrollbar { display: none; }
        .category-tabs .inner {
            display: flex;
            padding: 0 24px;
            gap: 0;
            justify-content: center;
        }
        .cat-tab {
            padding: 14px 24px;
            font-size: 0.85rem;
            letter-spacing: 0.5px;
            border: none;
            background: none;
            color: var(--grey);
            cursor: pointer;
            white-space: nowrap;
            border-bottom: 2px solid transparent;
            transition: var(--ease);
            font-weight: 400;
        }
        .cat-tab:hover { color: var(--charcoal); }
        .cat-tab.active { 
            color: var(--charcoal); 
            border-bottom-color: var(--charcoal); 
            font-weight: 500;
        }

        /* Category Cards - Same as collections.ejs decor-cat-grid */
        .cat-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
            gap: 16px;
            margin-bottom: 50px;
            margin-top: 30px;
        }
        .cat-card {
            padding: 24px 16px;
            background: white;
            border-radius: 12px;
            text-align: center;
            text-decoration: none;
            color: var(--charcoal);
            border: 1px solid rgba(0,0,0,0.05);
            transition: var(--ease);
            cursor: pointer;
        }
        .cat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(0,0,0,0.08);
        }
        .cat-card.active {
            border-color: var(--charcoal);
            background: var(--charcoal);
            color: white;
        }
        .cat-card.active .cat-icon {
            color: white;
        }
        .cat-card.active .cat-name {
            color: white;
        }
        .cat-card.active .cat-count {
            color: rgba(255,255,255,0.7);
        }
        .cat-icon {
            font-size: 1.8rem;
            margin-bottom: 10px;
            color: var(--clay);
        }
        .cat-name {
            font-size: 0.9rem;
            font-weight: 500;
            margin-bottom: 2px;
        }
        .cat-count {
            font-size: 0.75rem;
            color: var(--grey);
        }

        .prod-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 24px;
            padding: 20px 0 60px;
        }
        .prod-card {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            text-decoration: none;
            color: inherit;
            transition: var(--ease);
            border: 1px solid rgba(0,0,0,0.05);
        }
        .prod-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.08);
            text-decoration: none;
            color: inherit;
        }
        .prod-img {
            aspect-ratio: 1/1;
            background: var(--stone);
            overflow: hidden;
        }
        .prod-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }
        .prod-card:hover .prod-img img {
            transform: scale(1.05);
        }
        .prod-info {
            padding: 18px;
        }
        .prod-subcat {
            font-size: 0.7rem;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--clay);
            margin-bottom: 6px;
        }
        .prod-name {
            font-size: 1rem;
            font-weight: 500;
            margin-bottom: 6px;
            line-height: 1.3;
        }
        .prod-price {
            font-size: 0.9rem;
            color: var(--grey);
            margin-bottom: 8px;
        }
        .btn-add {
            width: 100%;
            padding: 10px;
            background: transparent;
            border: 1px solid var(--charcoal);
            border-radius: 40px;
            font-size: 0.85rem;
            cursor: pointer;
            transition: var(--ease);
            margin-top: 10px;
        }
        .btn-add:hover {
            background: var(--charcoal);
            color: white;
        }
        .empty-state {
            text-align: center;
            padding: 80px 20px;
            grid-column: 1/-1;
        }
        .empty-state i {
            font-size: 3rem;
            color: var(--linen);
            margin-bottom: 20px;
        }
        .breadcrumb {
            background: transparent;
            padding: 20px 0 0;
            margin-bottom: 0;
        }
        .breadcrumb a {
            color: var(--grey);
            text-decoration: none;
        }
        .breadcrumb a:hover {
            color: var(--charcoal);
        }

        @media (max-width: 768px) {
            .cat-grid {
                grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
                gap: 12px;
            }
            .cat-card {
                padding: 16px 12px;
            }
            .cat-icon {
                font-size: 1.4rem;
            }
            .prod-grid {
                grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
                gap: 16px;
            }
            .cat-tab {
                padding: 10px 16px;
                font-size: 0.75rem;
            }
        }
    </style>
</head>
<body>
    <%- include('partials/header') %>

    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">Bedding</li>
            </ol>
        </nav>
    </div>

    <section class="page-hero">
        <span class="eyebrow">Luxury Bedding</span>
        <h1>Designed for deep rest</h1>
        <p class="subtitle">Experience the pinnacle of comfort with our premium bedding collection</p>
    </section>

    <!-- Category Tabs - Text only, matching collections.ejs filter-bar -->
    <div class="category-tabs">
        <div class="inner">
            <button class="cat-tab active" data-category="all">All Bedding</button>
            <button class="cat-tab" data-category="sheets">Bedsheets</button>
            <button class="cat-tab" data-category="duvet">Duvets</button>
            <button class="cat-tab" data-category="pillows">Pillows</button>
            <button class="cat-tab" data-category="towels">Towels</button>
            <button class="cat-tab" data-category="throws">Throw Blankets</button>
            <button class="cat-tab" data-category="robes">Robes</button>
        </div>
    </div>

    <div class="container">
        <!-- Category Cards with Icons - Same style as collections.ejs -->
        <div class="cat-grid">
            <div class="cat-card active" data-category="all">
                <div class="cat-icon"><i class="fas fa-bed"></i></div>
                <div class="cat-name">All Bedding</div>
                <div class="cat-count"><%= products ? products.length : 0 %> items</div>
            </div>
            <div class="cat-card" data-category="sheets">
                <div class="cat-icon"><i class="fas fa-bed"></i></div>
                <div class="cat-name">Bedsheets</div>
                <div class="cat-count">0</div>
            </div>
            <div class="cat-card" data-category="duvet">
                <div class="cat-icon"><i class="fas fa-tshirt"></i></div>
                <div class="cat-name">Duvets</div>
                <div class="cat-count">0</div>
            </div>
            <div class="cat-card" data-category="pillows">
                <div class="cat-icon"><i class="fas fa-bed"></i></div>
                <div class="cat-name">Pillows</div>
                <div class="cat-count">0</div>
            </div>
            <div class="cat-card" data-category="towels">
                <div class="cat-icon"><i class="fas fa-hand-peace"></i></div>
                <div class="cat-name">Towels</div>
                <div class="cat-count">0</div>
            </div>
            <div class="cat-card" data-category="throws">
                <div class="cat-icon"><i class="fas fa-thermometer-half"></i></div>
                <div class="cat-name">Throw Blankets</div>
                <div class="cat-count">0</div>
            </div>
            <div class="cat-card" data-category="robes">
                <div class="cat-icon"><i class="fas fa-user"></i></div>
                <div class="cat-name">Robes</div>
                <div class="cat-count">0</div>
            </div>
        </div>

        <!-- Products Grid -->
        <div class="prod-grid" id="productsGrid">
            <% if (products && products.length > 0) { %>
                <% products.forEach(p => { %>
                <a href="/product/<%= p._id %>" class="prod-card" data-subcategory="<%= p.subcategory || '' %>">
                    <div class="prod-img">
                        <% if (p.images && p.images[0]) { %>
                            <img src="<%= p.images[0].url %>" alt="<%= p.name %>">
                        <% } else { %>
                            <div class="no-img" style="display: flex; align-items: center; justify-content: center; height: 100%;">
                                <i class="fas fa-image fa-3x" style="color:#ccc;"></i>
                            </div>
                        <% } %>
                    </div>
                    <div class="prod-info">
                        <div class="prod-subcat"><%= p.subcategory || p.category %></div>
                        <div class="prod-name"><%= p.name %></div>
                        <div class="prod-price">₦<%= Number(p.discountPrice || p.price).toLocaleString() %></div>
                        <button class="btn-add add-to-cart-btn" data-id="<%= p._id %>" onclick="event.stopPropagation(); addToCart(event, '<%= p._id %>')" <%= p.stock === 0 ? 'disabled' : '' %>>
                            <%= p.stock === 0 ? 'Out of Stock' : 'Add to Cart' %>
                        </button>
                    </div>
                </a>
                <% }) %>
            <% } else { %>
                <div class="empty-state">
                    <i class="fas fa-bed"></i>
                    <h3>Coming Soon</h3>
                    <p>Our luxury bedding collection is being curated. Check back soon!</p>
                </div>
            <% } %>
        </div>
    </div>

    <%- include('partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Tab filtering (text only tabs at the top)
        const tabs = document.querySelectorAll('.cat-tab');
        // Card filtering (icon cards below)
        const catCards = document.querySelectorAll('.cat-card');
        const products = document.querySelectorAll('.prod-card');

        // Tab click handler
        tabs.forEach(tab => {
            tab.addEventListener('click', () => {
                const category = tab.dataset.category;
                
                tabs.forEach(t => t.classList.remove('active'));
                tab.classList.add('active');
                
                // Also update active card
                catCards.forEach(card => {
                    if (card.dataset.category === category) {
                        card.classList.add('active');
                    } else {
                        card.classList.remove('active');
                    }
                });
                
                // Filter products
                products.forEach(product => {
                    if (category === 'all') {
                        product.style.display = 'block';
                    } else {
                        const productCat = product.dataset.subcategory?.toLowerCase();
                        if (productCat === category.toLowerCase()) {
                            product.style.display = 'block';
                        } else {
                            product.style.display = 'none';
                        }
                    }
                });
            });
        });

        // Card click handler
        catCards.forEach(card => {
            card.addEventListener('click', () => {
                const category = card.dataset.category;
                
                catCards.forEach(c => c.classList.remove('active'));
                card.classList.add('active');
                
                // Also update active tab
                tabs.forEach(tab => {
                    if (tab.dataset.category === category) {
                        tab.classList.add('active');
                    } else {
                        tab.classList.remove('active');
                    }
                });
                
                // Filter products
                products.forEach(product => {
                    if (category === 'all') {
                        product.style.display = 'block';
                    } else {
                        const productCat = product.dataset.subcategory?.toLowerCase();
                        if (productCat === category.toLowerCase()) {
                            product.style.display = 'block';
                        } else {
                            product.style.display = 'none';
                        }
                    }
                });
            });
        });

        async function addToCart(event, productId) {
            event.preventDefault();
            event.stopPropagation();
            
            const button = event.target;
            const originalText = button.textContent;
            button.disabled = true;
            button.textContent = 'Adding...';

            try {
                const response = await fetch('/cart/add', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({ productId, quantity: 1 })
                });

                const data = await response.json();

                if (data.success) {
                    button.textContent = '✓ Added';
                    setTimeout(() => {
                        button.textContent = originalText;
                        button.disabled = false;
                    }, 1500);
                } else {
                    alert(data.message || 'Could not add to cart');
                    button.textContent = originalText;
                    button.disabled = false;
                }
            } catch (err) {
                console.error('Error:', err);
                alert('Error adding to cart');
                button.textContent = originalText;
                button.disabled = false;
            }
        }
    </script>
</body>
</html>