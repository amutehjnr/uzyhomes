<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Settings — UZYHOMES Admin</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    /* ── Settings Tab Styles ── */
    .settings-tabs-bar {
      display: flex;
      gap: 0;
      border-bottom: 1px solid var(--border, #e0dbd5);
      margin-bottom: 28px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .settings-tabs-bar::-webkit-scrollbar { display: none; }

    .settings-tab {
      padding: 12px 22px;
      background: none;
      border: none;
      border-bottom: 2px solid transparent;
      color: var(--text-secondary, #777);
      cursor: pointer;
      font-family: inherit;
      font-size: 0.875rem;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.25s;
      white-space: nowrap;
      margin-bottom: -1px;
    }
    .settings-tab:hover  { color: var(--text-primary, #2D2D2D); }
    .settings-tab.active {
      color: var(--accent, #A68A6F);
      border-bottom-color: var(--accent, #A68A6F);
    }

    .tab-panel { display: none; }
    .tab-panel.active { display: block; }

    /* Card overrides */
    .settings-card {
      background: #fff;
      border: 1px solid var(--border, #e0dbd5);
      border-radius: 8px;
      margin-bottom: 24px;
    }
    .settings-card-header {
      padding: 18px 24px;
      border-bottom: 1px solid var(--border, #e0dbd5);
      font-size: 1rem;
      font-weight: 600;
      color: var(--text-primary, #2D2D2D);
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .settings-card-body { padding: 24px; }

    /* Form */
    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }
    @media (max-width: 640px) { .form-row { grid-template-columns: 1fr; } }

    .form-group { margin-bottom: 18px; }
    .form-label {
      display: block;
      font-size: 0.83rem;
      font-weight: 500;
      color: var(--text-secondary, #777);
      margin-bottom: 6px;
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }
    .form-control, .form-select {
      width: 100%;
      padding: 10px 14px;
      border: 1px solid var(--border, #e0dbd5);
      border-radius: 6px;
      font-size: 0.9rem;
      font-family: inherit;
      transition: border-color 0.2s;
      background: #fff;
    }
    .form-control:focus, .form-select:focus {
      outline: none;
      border-color: var(--accent, #A68A6F);
      box-shadow: 0 0 0 3px rgba(166,138,111,0.12);
    }
    .form-control[readonly] {
      background: #f9f8f7;
      cursor: not-allowed;
      opacity: 0.7;
    }
    .form-hint {
      font-size: 0.78rem;
      color: var(--text-muted, #aaa);
      margin-top: 4px;
    }
    textarea.form-control { resize: vertical; min-height: 90px; }

    /* Toggle switch */
    .setting-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 0;
      border-bottom: 1px solid var(--border, #e0dbd5);
    }
    .setting-row:last-child { border-bottom: none; }
    .setting-info { flex: 1; padding-right: 20px; }
    .setting-label { font-size: 0.9rem; font-weight: 500; color: var(--text-primary, #2D2D2D); }
    .setting-desc  { font-size: 0.8rem; color: var(--text-secondary, #777); margin-top: 2px; }

    .toggle-switch { position: relative; width: 46px; height: 24px; flex-shrink: 0; }
    .toggle-switch input { opacity: 0; width: 0; height: 0; }
    .toggle-slider {
      position: absolute; inset: 0;
      background: #ccc; border-radius: 24px;
      cursor: pointer; transition: .3s;
    }
    .toggle-slider::before {
      content: '';
      position: absolute;
      width: 18px; height: 18px;
      left: 3px; bottom: 3px;
      background: white; border-radius: 50%;
      transition: .3s;
    }
    input:checked + .toggle-slider { background: var(--accent, #A68A6F); }
    input:checked + .toggle-slider::before { transform: translateX(22px); }

    /* Buttons */
    .btn-save {
      padding: 10px 26px;
      background: var(--text-primary, #2D2D2D);
      color: #fff;
      border: none;
      border-radius: 6px;
      font-size: 0.9rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.25s;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .btn-save:hover { background: #444; transform: translateY(-1px); }
    .btn-save:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

    .btn-danger {
      padding: 10px 26px;
      background: #dc3545;
      color: #fff;
      border: none;
      border-radius: 6px;
      font-size: 0.9rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.25s;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .btn-danger:hover { background: #c82333; }

    /* Avatar */
    .profile-avatar-wrap {
      display: flex;
      align-items: center;
      gap: 20px;
      padding: 18px 0;
      margin-bottom: 20px;
      border-bottom: 1px solid var(--border, #e0dbd5);
    }
    .admin-avatar-circle {
      width: 70px; height: 70px;
      border-radius: 50%;
      background: linear-gradient(135deg, #A68A6F, #8B7355);
      color: #fff;
      font-size: 1.6rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .profile-avatar-info h4 { font-size: 1.05rem; font-weight: 600; margin: 0 0 2px; }
    .profile-avatar-info p  { font-size: 0.85rem; color: var(--text-secondary, #777); margin: 0; }

    /* Badge */
    .badge-role {
      display: inline-block;
      padding: 3px 10px;
      background: rgba(166,138,111,0.15);
      color: var(--accent, #A68A6F);
      border-radius: 20px;
      font-size: 0.72rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    /* Password strength */
    .strength-bar { height: 4px; background: #e0e0e0; border-radius: 2px; margin: 6px 0 4px; }
    .strength-fill { height: 100%; border-radius: 2px; transition: all 0.3s; }
    .strength-fill.weak   { width: 25%; background: #dc3545; }
    .strength-fill.fair   { width: 50%; background: #ffc107; }
    .strength-fill.good   { width: 75%; background: #17a2b8; }
    .strength-fill.strong { width: 100%; background: #28a745; }

    /* Alert inline */
    .alert-inline {
      display: none;
      padding: 10px 14px;
      border-radius: 6px;
      font-size: 0.87rem;
      margin-bottom: 16px;
      align-items: center;
      gap: 8px;
    }
    .alert-inline.show { display: flex; }
    .alert-inline.success { background: #e8f5e9; color: #1b5e20; border: 1px solid #c8e6c9; }
    .alert-inline.error   { background: #ffebee; color: #b71c1c; border: 1px solid #ffcdd2; }
    .alert-inline.info    { background: #e3f2fd; color: #0d47a1; border: 1px solid #bbdefb; }

    /* Session info */
    .session-card {
      background: #f9f8f7;
      border: 1px solid var(--border, #e0dbd5);
      border-radius: 6px;
      padding: 14px 18px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
    }
    .session-info p { margin: 0; font-size: 0.87rem; color: var(--text-secondary, #777); }
    .session-info strong { color: var(--text-primary, #2D2D2D); }
    .badge-active {
      background: #e8f5e9; color: #1b5e20;
      padding: 4px 12px; border-radius: 20px;
      font-size: 0.75rem; font-weight: 600;
    }

    /* Notification category */
    .notif-category-title {
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: var(--accent, #A68A6F);
      margin: 20px 0 8px;
    }
    .notif-category-title:first-child { margin-top: 0; }
  </style>
</head>
<body data-page="settings">

<%- include('./partials/sidebar', { currentPage: 'settings', user: user }) %>

<div class="admin-main">
  <%- include('./partials/header', { pageTitle: 'Settings', user: user }) %>

  <div class="admin-content">

    <div class="page-header">
      <div>
        <h1 class="page-title">Settings</h1>
        <p class="page-subtitle">Configure your store preferences and account</p>
      </div>
    </div>

    <!-- ── Tabs ── -->
    <div class="settings-tabs-bar" id="settingsTabs">
      <button class="settings-tab active" data-panel="store"         onclick="switchSettingsTab(this)"><i class="fas fa-store"></i> Store</button>
      <button class="settings-tab"        data-panel="account"       onclick="switchSettingsTab(this)"><i class="fas fa-user"></i> Account</button>
      <button class="settings-tab"        data-panel="security"      onclick="switchSettingsTab(this)"><i class="fas fa-shield-alt"></i> Security</button>
      <button class="settings-tab"        data-panel="notifications" onclick="switchSettingsTab(this)"><i class="fas fa-bell"></i> Notifications</button>
    </div>

    <!-- ══════════════════════════════════════════════════════
         STORE TAB
    ═══════════════════════════════════════════════════════ -->
    <div id="panel-store" class="tab-panel active">

      <!-- General Info -->
      <div class="settings-card">
        <div class="settings-card-header"><i class="fas fa-info-circle"></i> Store Information</div>
        <div class="settings-card-body">
          <div id="storeAlert" class="alert-inline"></div>
          <form id="storeForm">
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Store Name</label>
                <input type="text" class="form-control" name="storeName" value="UZYHOMES" placeholder="Your store name">
              </div>
              <div class="form-group">
                <label class="form-label">Store Email</label>
                <input type="email" class="form-control" name="storeEmail" value="hello@uzyhomes.com" placeholder="store@example.com">
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Phone Number</label>
                <input type="text" class="form-control" name="storePhone" value="+234 704 751 1911" placeholder="+234 ...">
              </div>
              <div class="form-group">
                <label class="form-label">Currency</label>
                <select class="form-select" name="currency">
                  <option value="NGN" selected>Nigerian Naira (₦)</option>
                  <option value="USD">US Dollar ($)</option>
                  <option value="GBP">British Pound (£)</option>
                  <option value="EUR">Euro (€)</option>
                </select>
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Timezone</label>
                <select class="form-select" name="timezone">
                  <option value="Africa/Lagos" selected>Africa/Lagos (WAT)</option>
                  <option value="UTC">UTC</option>
                  <option value="Europe/London">Europe/London</option>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label">Low Stock Threshold</label>
                <input type="number" class="form-control" name="lowStockThreshold" value="10" min="1">
                <span class="form-hint">Alert when stock falls below this number</span>
              </div>
            </div>
            <div class="form-group">
              <label class="form-label">Store Address</label>
              <textarea class="form-control" name="storeAddress" placeholder="Full store address">Praf Mall, Aminu Kano Crescent, Wuse 2, Abuja, Nigeria</textarea>
            </div>
            <div style="display:flex; justify-content:flex-end">
              <button type="button" class="btn-save" onclick="saveStore()">
                <i class="fas fa-save"></i> Save Store Info
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- Features toggles -->
      <div class="settings-card">
        <div class="settings-card-header"><i class="fas fa-toggle-on"></i> Store Features</div>
        <div class="settings-card-body">
          <div id="featuresAlert" class="alert-inline"></div>
          <div class="setting-row">
            <div class="setting-info">
              <div class="setting-label">Maintenance Mode</div>
              <div class="setting-desc">Temporarily close the store — only admins can access it</div>
            </div>
            <label class="toggle-switch"><input type="checkbox" id="feat-maintenance"><span class="toggle-slider"></span></label>
          </div>
          <div class="setting-row">
            <div class="setting-info">
              <div class="setting-label">Guest Checkout</div>
              <div class="setting-desc">Allow customers to purchase without creating an account</div>
            </div>
            <label class="toggle-switch"><input type="checkbox" id="feat-guestCheckout" checked><span class="toggle-slider"></span></label>
          </div>
          <div class="setting-row">
            <div class="setting-info">
              <div class="setting-label">Product Reviews</div>
              <div class="setting-desc">Allow customers to leave product reviews</div>
            </div>
            <label class="toggle-switch"><input type="checkbox" id="feat-reviews" checked><span class="toggle-slider"></span></label>
          </div>
          <div class="setting-row">
            <div class="setting-info">
              <div class="setting-label">Wishlist</div>
              <div class="setting-desc">Let customers save items to a personal wishlist</div>
            </div>
            <label class="toggle-switch"><input type="checkbox" id="feat-wishlist" checked><span class="toggle-slider"></span></label>
          </div>
          <div class="setting-row">
            <div class="setting-info">
              <div class="setting-label">Low Stock Alerts</div>
              <div class="setting-desc">Receive email when product stock drops below the threshold</div>
            </div>
            <label class="toggle-switch"><input type="checkbox" id="feat-lowStock" checked><span class="toggle-slider"></span></label>
          </div>
          <div style="display:flex; justify-content:flex-end; margin-top:16px">
            <button type="button" class="btn-save" onclick="saveFeatures()">
              <i class="fas fa-save"></i> Save Features
            </button>
          </div>
        </div>
      </div>

      <!-- Shipping -->
      <div class="settings-card">
        <div class="settings-card-header"><i class="fas fa-truck"></i> Shipping Settings</div>
        <div class="settings-card-body">
          <div id="shippingAlert" class="alert-inline"></div>
          <form id="shippingForm">
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Free Shipping Threshold (₦)</label>
                <input type="number" class="form-control" name="freeShippingThreshold" value="50000" min="0">
                <span class="form-hint">Orders above this amount get free shipping</span>
              </div>
              <div class="form-group">
                <label class="form-label">Standard Shipping Rate (₦)</label>
                <input type="number" class="form-control" name="standardShippingRate" value="2500" min="0">
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Express Shipping Rate (₦)</label>
                <input type="number" class="form-control" name="expressShippingRate" value="12000" min="0">
              </div>
              <div class="form-group">
                <label class="form-label">Default Carrier</label>
                <select class="form-select" name="defaultCarrier">
                  <option value="dhl">DHL</option>
                  <option value="fedex">FedEx</option>
                  <option value="gig" selected>GIG Logistics</option>
                  <option value="redstar">Red Star Express</option>
                </select>
              </div>
            </div>
            <div style="display:flex; justify-content:flex-end">
              <button type="button" class="btn-save" onclick="saveShipping()">
                <i class="fas fa-save"></i> Save Shipping
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- Payment Keys -->
      <div class="settings-card">
        <div class="settings-card-header"><i class="fas fa-credit-card"></i> Payment Gateway</div>
        <div class="settings-card-body">
          <div id="paymentAlert" class="alert-inline"></div>
          <form id="paymentForm">
            <div class="form-group">
              <label class="form-label">Paystack Public Key</label>
              <input type="text" class="form-control" name="paystackPublicKey" placeholder="pk_live_..." autocomplete="off">
            </div>
            <div class="form-group">
              <label class="form-label">Paystack Secret Key</label>
              <input type="password" class="form-control" name="paystackSecretKey" placeholder="sk_live_..." autocomplete="new-password">
              <span class="form-hint">Keys are stored securely and never displayed again once saved</span>
            </div>
            <div style="display:flex; justify-content:flex-end">
              <button type="button" class="btn-save" onclick="savePaymentKeys()">
                <i class="fas fa-save"></i> Save Payment Keys
              </button>
            </div>
          </form>
        </div>
      </div>
    </div><!-- /panel-store -->


    <!-- ══════════════════════════════════════════════════════
         ACCOUNT TAB
    ═══════════════════════════════════════════════════════ -->
    <div id="panel-account" class="tab-panel">
      <div class="settings-card">
        <div class="settings-card-header"><i class="fas fa-user-circle"></i> Admin Profile</div>
        <div class="settings-card-body">
          <div id="profileAlert" class="alert-inline"></div>

          <!-- Avatar row -->
          <div class="profile-avatar-wrap">
            <div class="admin-avatar-circle" id="avatarCircle">
              <%= user && user.firstName ? user.firstName.charAt(0).toUpperCase() : 'A' %>
            </div>
            <div class="profile-avatar-info">
              <h4 id="avatarName"><%= user && user.firstName ? user.firstName + ' ' + (user.lastName || '') : 'Admin User' %></h4>
              <p id="avatarEmail"><%= user && user.email ? user.email : '' %></p>
              <span class="badge-role"><%= user && user.role ? user.role.replace('_', ' ') : 'Admin' %></span>
            </div>
          </div>

          <form id="profileForm">
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">First Name</label>
                <input type="text" class="form-control" id="pf-firstName" name="firstName"
                       value="<%= user && user.firstName ? user.firstName : '' %>" required>
              </div>
              <div class="form-group">
                <label class="form-label">Last Name</label>
                <input type="text" class="form-control" id="pf-lastName" name="lastName"
                       value="<%= user && user.lastName ? user.lastName : '' %>" required>
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Email Address</label>
                <input type="email" class="form-control" name="email"
                       value="<%= user && user.email ? user.email : '' %>" readonly>
                <span class="form-hint">Contact a super admin to change your email address</span>
              </div>
              <div class="form-group">
                <label class="form-label">Phone Number</label>
                <input type="text" class="form-control" id="pf-phone" name="phone"
                       value="<%= user && user.phone ? user.phone : '' %>" placeholder="+234 ...">
              </div>
            </div>
            <div style="display:flex; justify-content:flex-end">
              <button type="button" class="btn-save" onclick="saveProfile()">
                <i class="fas fa-save"></i> Update Profile
              </button>
            </div>
          </form>
        </div>
      </div>
    </div><!-- /panel-account -->


    <!-- ══════════════════════════════════════════════════════
         SECURITY TAB
    ═══════════════════════════════════════════════════════ -->
    <div id="panel-security" class="tab-panel">

      <!-- Change Password -->
      <div class="settings-card">
        <div class="settings-card-header"><i class="fas fa-lock"></i> Change Password</div>
        <div class="settings-card-body">
          <div id="passwordAlert" class="alert-inline"></div>
          <form id="passwordForm" autocomplete="off">
            <div class="form-group">
              <label class="form-label">Current Password</label>
              <input type="password" class="form-control" id="sec-current" autocomplete="current-password" placeholder="Enter your current password">
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">New Password</label>
                <input type="password" class="form-control" id="sec-new" autocomplete="new-password" placeholder="At least 8 characters"
                       oninput="checkPasswordStrength(this.value)">
                <div class="strength-bar"><div class="strength-fill" id="strengthFill"></div></div>
                <span class="form-hint" id="strengthText">Enter a new password</span>
              </div>
              <div class="form-group">
                <label class="form-label">Confirm New Password</label>
                <input type="password" class="form-control" id="sec-confirm" autocomplete="new-password" placeholder="Repeat new password">
              </div>
            </div>
            <div style="display:flex; justify-content:flex-end">
              <button type="button" class="btn-save" onclick="changePassword()">
                <i class="fas fa-key"></i> Update Password
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- Active Sessions -->
      <div class="settings-card">
        <div class="settings-card-header"><i class="fas fa-desktop"></i> Active Session</div>
        <div class="settings-card-body">
          <div class="session-card">
            <div class="session-info">
              <p><strong>Current session</strong></p>
              <p>Last login:
                <%= user && user.lastLogin
                    ? new Date(user.lastLogin).toLocaleString('en-US', { dateStyle:'medium', timeStyle:'short' })
                    : 'Unknown' %>
                &nbsp;|&nbsp; IP: <%= user && user.lastLoginIp ? user.lastLoginIp : 'Unknown' %>
              </p>
            </div>
            <span class="badge-active">● Active</span>
          </div>
          <div style="margin-top:16px">
            <button class="btn-danger" onclick="signOutAll()">
              <i class="fas fa-sign-out-alt"></i> Sign Out All Devices
            </button>
          </div>
        </div>
      </div>

      <!-- Two-Factor Auth -->
      <div class="settings-card">
        <div class="settings-card-header"><i class="fas fa-shield-alt"></i> Two-Factor Authentication</div>
        <div class="settings-card-body">
          <div class="setting-row" style="border:none; padding:0">
            <div class="setting-info">
              <div class="setting-label">Enable 2FA</div>
              <div class="setting-desc">Add an extra layer of security using an authenticator app (TOTP)</div>
            </div>
            <label class="toggle-switch">
              <input type="checkbox" id="sec-2fa"
                     <%= user && user.twoFactorEnabled ? 'checked' : '' %>
                     onchange="toggle2FA(this.checked)">
              <span class="toggle-slider"></span>
            </label>
          </div>
        </div>
      </div>
    </div><!-- /panel-security -->


    <!-- ══════════════════════════════════════════════════════
         NOTIFICATIONS TAB
    ═══════════════════════════════════════════════════════ -->
    <div id="panel-notifications" class="tab-panel">
      <div class="settings-card">
        <div class="settings-card-header"><i class="fas fa-envelope"></i> Email Notifications</div>
        <div class="settings-card-body">
          <div id="notifAlert" class="alert-inline"></div>

          <div class="notif-category-title">Orders</div>
          <div class="setting-row">
            <div class="setting-info">
              <div class="setting-label">New Order Placed</div>
              <div class="setting-desc">Receive an email every time a customer places an order</div>
            </div>
