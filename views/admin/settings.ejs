            </div>
            <label class="toggle-switch"><input type="checkbox" id="notif-newUser"><span class="toggle-slider"></span></label>
          </div>
          <div class="setting-row">
            <div class="setting-info">
              <div class="setting-label">Low Stock Alert</div>
              <div class="setting-desc">Notify when a product's stock drops below the threshold</div>
            </div>
            <label class="toggle-switch"><input type="checkbox" id="notif-lowStock" checked><span class="toggle-slider"></span></label>
          </div>
          <div class="setting-row">
            <div class="setting-info">
              <div class="setting-label">New Contact Message</div>
              <div class="setting-desc">Notify when a visitor submits the contact form</div>
            </div>
            <label class="toggle-switch"><input type="checkbox" id="notif-contact" checked><span class="toggle-slider"></span></label>
          </div>
          <div class="setting-row">
            <div class="setting-info">
              <div class="setting-label">New Newsletter Subscriber</div>
              <div class="setting-desc">Notify when someone subscribes to the newsletter</div>
            </div>
            <label class="toggle-switch"><input type="checkbox" id="notif-subscriber"><span class="toggle-slider"></span></label>
          </div>

          <div style="display:flex; justify-content:flex-end; margin-top:20px">
            <button type="button" class="btn-save" onclick="saveNotifications()">
              <i class="fas fa-save"></i> Save Preferences
            </button>
          </div>
