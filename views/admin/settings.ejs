      </div>
    </div><!-- /panel-notifications -->

  </div><!-- /admin-content -->
</div><!-- /admin-main -->

<div id="toastContainer" class="toast-container"></div>
<script src="/js/admin.js"></script>

<script>
/* ══════════════════════════════════════════════════════════
   TAB SWITCHING
══════════════════════════════════════════════════════════ */
function switchSettingsTab(btn) {
  document.querySelectorAll('.settings-tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('panel-' + btn.dataset.panel).classList.add('active');

  // Deep-link via hash
  history.replaceState(null, '', '#' + btn.dataset.panel);
}

// Restore tab from URL hash on load
document.addEventListener('DOMContentLoaded', () => {
  const hash = (window.location.hash || '').replace('#', '');
  if (hash) {
    const btn = document.querySelector(`[data-panel="${hash}"]`);
    if (btn) switchSettingsTab(btn);
  }
});

/* ══════════════════════════════════════════════════════════
   HELPERS
══════════════════════════════════════════════════════════ */
function showAlert(id, type, msg) {
  const el = document.getElementById(id);
  if (!el) return;
  el.className = `alert-inline ${type} show`;
  el.innerHTML = `<i class="fas fa-${type === 'success' ? 'check-circle' : type === 'error' ? 'times-circle' : 'info-circle'}"></i> ${msg}`;
  setTimeout(() => el.classList.remove('show'), 4000);
}

function setLoading(btn, loading) {
  if (loading) {
    btn.disabled = true;
    btn._text = btn.innerHTML;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Saving…';
  } else {
    btn.disabled = false;
    btn.innerHTML = btn._text;
  }
}

/* ══════════════════════════════════════════════════════════
   STORE FUNCTIONS
══════════════════════════════════════════════════════════ */
async function saveStore() {
  const btn = event.currentTarget;
  const form = document.getElementById('storeForm');
  const fd = new FormData(form);
  const data = {};
  fd.forEach((v, k) => data[k] = v);

  setLoading(btn, true);
  try {
    const res = await API.put('/admin/settings/general', data);
    if (res.ok) {
      showAlert('storeAlert', 'success', 'Store information saved successfully');
      Toast.success('Store settings saved');
    } else {
      showAlert('storeAlert', 'error', res.data?.message || 'Failed to save settings');
    }
  } catch (e) {
    showAlert('storeAlert', 'error', 'Network error. Please try again.');
  } finally {
    setLoading(btn, false);
  }
}

async function saveFeatures() {
  const btn = event.currentTarget;
  const features = {
    maintenance:   document.getElementById('feat-maintenance').checked,
    guestCheckout: document.getElementById('feat-guestCheckout').checked,
    reviews:       document.getElementById('feat-reviews').checked,
    wishlist:      document.getElementById('feat-wishlist').checked,
    lowStockAlerts:document.getElementById('feat-lowStock').checked,
  };

  setLoading(btn, true);
  try {
    const res = await API.put('/admin/settings/general', { features });
    if (res.ok) {
      showAlert('featuresAlert', 'success', 'Feature settings saved');
      Toast.success('Feature settings saved');
    } else {
      showAlert('featuresAlert', 'error', res.data?.message || 'Failed to save');
    }
  } catch (e) {
    showAlert('featuresAlert', 'error', 'Network error. Please try again.');
  } finally {
    setLoading(btn, false);
  }
}

async function saveShipping() {
  const btn = event.currentTarget;
  const form = document.getElementById('shippingForm');
  const fd = new FormData(form);
  const data = {};
  fd.forEach((v, k) => data[k] = v);

  setLoading(btn, true);
  try {
    const res = await API.put('/admin/settings/shipping', data);
    if (res.ok) {
      showAlert('shippingAlert', 'success', 'Shipping settings saved successfully');
      Toast.success('Shipping settings saved');
    } else {
      showAlert('shippingAlert', 'error', res.data?.message || 'Failed to save');
    }
  } catch (e) {
    showAlert('shippingAlert', 'error', 'Network error. Please try again.');
  } finally {
    setLoading(btn, false);
  }
}

async function savePaymentKeys() {
  const btn = event.currentTarget;
  const form = document.getElementById('paymentForm');
  const fd = new FormData(form);
  const data = {};
  fd.forEach((v, k) => { if (v.trim()) data[k] = v.trim(); });

  if (!data.paystackPublicKey && !data.paystackSecretKey) {
    showAlert('paymentAlert', 'info', 'No changes to save — fields are empty');
    return;
  }

  setLoading(btn, true);
  try {
    const res = await API.put('/admin/settings/payment', data);
    if (res.ok) {
      showAlert('paymentAlert', 'success', 'Payment keys saved securely');
      Toast.success('Payment settings saved');
      form.reset();
    } else {
      showAlert('paymentAlert', 'error', res.data?.message || 'Failed to save keys');
    }
  } catch (e) {
    showAlert('paymentAlert', 'error', 'Network error. Please try again.');
  } finally {
    setLoading(btn, false);
  }
}

/* ══════════════════════════════════════════════════════════
   ACCOUNT FUNCTIONS
══════════════════════════════════════════════════════════ */
async function saveProfile() {
  const btn = event.currentTarget;
  const firstName = document.getElementById('pf-firstName').value.trim();
  const lastName  = document.getElementById('pf-lastName').value.trim();
  const phone     = document.getElementById('pf-phone').value.trim();

  if (!firstName || !lastName) {
    showAlert('profileAlert', 'error', 'First name and last name are required');
    return;
  }

  setLoading(btn, true);
  try {
    const res = await API.put('/admin/auth/profile', { firstName, lastName, phone });
    if (res.ok) {
      showAlert('profileAlert', 'success', 'Profile updated successfully');
      Toast.success('Profile updated');
      // Update header avatar letter
      const initial = firstName.charAt(0).toUpperCase();
      document.getElementById('avatarCircle').textContent = initial;
      document.getElementById('avatarName').textContent = firstName + ' ' + lastName;
    } else {
      showAlert('profileAlert', 'error', res.data?.message || 'Failed to update profile');
    }
  } catch (e) {
    showAlert('profileAlert', 'error', 'Network error. Please try again.');
  } finally {
    setLoading(btn, false);
  }
}

/* ══════════════════════════════════════════════════════════
   SECURITY FUNCTIONS
══════════════════════════════════════════════════════════ */
function checkPasswordStrength(val) {
  const fill = document.getElementById('strengthFill');
  const text = document.getElementById('strengthText');
  if (!val) {
    fill.className = 'strength-fill';
    fill.style.width = '0';
    text.textContent = 'Enter a new password';
    return;
  }
  let score = 0;
  if (val.length >= 8)          score++;
  if (/[a-z]/.test(val))        score++;
  if (/[A-Z]/.test(val))        score++;
  if (/[0-9]/.test(val))        score++;
  if (/[^a-zA-Z0-9]/.test(val)) score++;

  const map = {
    1: ['weak',   'Weak — too short'],
    2: ['weak',   'Weak'],
    3: ['fair',   'Fair — add numbers or symbols'],
    4: ['good',   'Good'],
    5: ['strong', 'Strong password ✓'],
  };
  const [cls, label] = map[score] || ['weak', 'Weak'];
  fill.className = `strength-fill ${cls}`;
  text.textContent = label;
}

async function changePassword() {
  const btn = event.currentTarget;
  const current = document.getElementById('sec-current').value;
  const newPw    = document.getElementById('sec-new').value;
  const confirm  = document.getElementById('sec-confirm').value;

  if (!current) { showAlert('passwordAlert', 'error', 'Please enter your current password'); return; }
  if (!newPw)   { showAlert('passwordAlert', 'error', 'Please enter a new password'); return; }
  if (newPw.length < 8) { showAlert('passwordAlert', 'error', 'New password must be at least 8 characters'); return; }
  if (newPw !== confirm) { showAlert('passwordAlert', 'error', 'New passwords do not match'); return; }

  setLoading(btn, true);
  try {
    const res = await API.post('/admin/auth/change-password', { currentPassword: current, newPassword: newPw });
    if (res.ok) {
      showAlert('passwordAlert', 'success', 'Password changed successfully');
      Toast.success('Password changed');
      document.getElementById('passwordForm').reset();
      document.getElementById('strengthFill').className = 'strength-fill';
      document.getElementById('strengthFill').style.width = '0';
      document.getElementById('strengthText').textContent = 'Enter a new password';
    } else {
      showAlert('passwordAlert', 'error', res.data?.message || 'Failed to change password');
    }
  } catch (e) {
    showAlert('passwordAlert', 'error', 'Network error. Please try again.');
  } finally {
    setLoading(btn, false);
  }
}

async function signOutAll() {
  if (!confirm('Are you sure you want to sign out from all devices?')) return;
  try {
    await API.post('/admin/auth/logout');
    Toast.success('Signed out from all devices');
    localStorage.removeItem('adminToken');
    localStorage.removeItem('adminRefreshToken');
    setTimeout(() => window.location.href = '/admin/login', 1200);
  } catch (e) {
    Toast.error('Error signing out');
  }
}

async function toggle2FA(enabled) {
  Toast.info(`Two-factor authentication ${enabled ? 'enabled' : 'disabled'} (feature coming soon)`);
  // Implement 2FA API call when backend is ready
}

/* ══════════════════════════════════════════════════════════
   NOTIFICATION FUNCTIONS
══════════════════════════════════════════════════════════ */
async function saveNotifications() {
  const btn = event.currentTarget;
  const prefs = {
    newOrder:       document.getElementById('notif-newOrder').checked,
    orderCancelled: document.getElementById('notif-orderCancelled').checked,
    refund:         document.getElementById('notif-refund').checked,
    payment:        document.getElementById('notif-payment').checked,
    paymentFailed:  document.getElementById('notif-paymentFailed').checked,
    newUser:        document.getElementById('notif-newUser').checked,
    lowStock:       document.getElementById('notif-lowStock').checked,
    contact:        document.getElementById('notif-contact').checked,
    subscriber:     document.getElementById('notif-subscriber').checked,
  };

  setLoading(btn, true);
  try {
    // Save to localStorage as fallback (backend endpoint optional)
    localStorage.setItem('adminNotifPrefs', JSON.stringify(prefs));

    const res = await API.put('/admin/settings/general', { notifications: prefs });
    showAlert('notifAlert', 'success', 'Notification preferences saved');
    Toast.success('Notification preferences saved');
  } catch (e) {
    // Even if API call fails, localStorage is saved
    showAlert('notifAlert', 'success', 'Notification preferences saved locally');
    Toast.success('Preferences saved');
  } finally {
    setLoading(btn, false);
  }
}

// Restore notification prefs from localStorage on load
document.addEventListener('DOMContentLoaded', () => {
  const saved = localStorage.getItem('adminNotifPrefs');
  if (saved) {
    try {
      const prefs = JSON.parse(saved);
      Object.entries(prefs).forEach(([key, val]) => {
        const el = document.getElementById(`notif-${key}`);
        if (el) el.checked = val;
      });
    } catch (e) { /* ignore */ }
  }
});
</script>
</body>
