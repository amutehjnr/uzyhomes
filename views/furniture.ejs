<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Luxury Furniture Collection — Sofas, Armchairs, Coffee Tables, Sideboards, Bookshelves at UZYHOMES">
    <title>Furniture Collection | UZYHOMES</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">

    <style>
        :root {
            --ivory: #FAF9F7;
            --stone: #F5F3F0;
            --sand: #E8E4DD;
            --charcoal: #2D2D2D;
            --grey: #777777;
            --clay: #A68A6F;
            --linen: #D9D1C7;
            --font-serif: 'Playfair Display', Georgia, serif;
            --font-sans: 'Inter', sans-serif;
            --ease: all 0.3s cubic-bezier(0.4,0,0.2,1);
        }

        body { font-family: var(--font-sans); font-weight: 300; color: var(--charcoal); background: var(--ivory); }

        .page-hero {
            padding: 120px 0 60px;
            text-align: center;
            background: linear-gradient(to bottom, var(--stone), var(--ivory));
        }
        .page-hero .eyebrow {
            font-size: 0.72rem; letter-spacing: 3px; text-transform: uppercase;
            color: var(--grey); margin-bottom: 14px; display: block;
        }
        .page-hero h1 {
            font-family: var(--font-serif); font-size: clamp(2rem, 4.5vw, 3.2rem);
            font-weight: 400; max-width: 640px; margin: 0 auto 14px; line-height: 1.18;
        }
        .page-hero .subtitle {
            font-size: 1rem; color: var(--grey); max-width: 440px; margin: 0 auto;
        }

        .category-tabs {
            background: white;
            border-bottom: 1px solid rgba(0,0,0,0.06);
            position: sticky;
            top: 70px;
            z-index: 99;
            overflow-x: auto;
            scrollbar-width: none;
        }
        .category-tabs::-webkit-scrollbar { display: none; }
        .category-tabs .inner {
            display: flex;
            padding: 0 24px;
            gap: 0;
            justify-content: center;
        }
        .cat-tab {
            padding: 14px 24px;
            font-size: 0.85rem;
            letter-spacing: 0.5px;
            border: none;
            background: none;
            color: var(--grey);
            cursor: pointer;
            white-space: nowrap;
            border-bottom: 2px solid transparent;
            transition: var(--ease);
            font-weight: 400;
        }
        .cat-tab:hover { color: var(--charcoal); }
        .cat-tab.active { 
            color: var(--charcoal); 
            border-bottom-color: var(--charcoal); 
            font-weight: 500;
        }

        .cat-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
            gap: 16px;
            margin-bottom: 50px;
            margin-top: 30px;
        }
        .cat-card {
            padding: 24px 16px;
            background: white;
            border-radius: 12px;
            text-align: center;
            text-decoration: none;
            color: var(--charcoal);
            border: 1px solid rgba(0,0,0,0.05);
            transition: var(--ease);
            cursor: pointer;
        }
        .cat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(0,0,0,0.08);
        }
        .cat-card.active {
            border-color: var(--charcoal);
            background: var(--charcoal);
            color: white;
        }
        .cat-card.active .cat-icon {
            color: white;
        }
        .cat-card.active .cat-name {
            color: white;
        }
        .cat-card.active .cat-count {
            color: rgba(255,255,255,0.7);
        }
        .cat-icon {
            font-size: 1.8rem;
            margin-bottom: 10px;
            color: var(--clay);
        }
        .cat-name {
            font-size: 0.9rem;
            font-weight: 500;
            margin-bottom: 2px;
        }
        .cat-count {
            font-size: 0.75rem;
            color: var(--grey);
        }

        .sort-wrap {
            display: flex;
            justify-content: flex-end;
            margin: 30px 0 20px;
        }
        .sort-btn {
            padding: 8px 20px;
            font-size: 0.85rem;
            border: 1px solid var(--sand);
            background: white;
            cursor: pointer;
            color: var(--charcoal);
            transition: var(--ease);
            border-radius: 40px;
        }
        .sort-btn:hover {
            border-color: var(--charcoal);
        }

        .prod-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 24px;
            padding: 20px 0 60px;
        }
        .prod-card {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            text-decoration: none;
            color: inherit;
            transition: var(--ease);
            border: 1px solid rgba(0,0,0,0.05);
        }
        .prod-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.08);
            text-decoration: none;
            color: inherit;
        }
        .prod-img {
            aspect-ratio: 1/1;
            background: var(--stone);
            overflow: hidden;
        }
        .prod-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }
        .prod-card:hover .prod-img img {
            transform: scale(1.05);
        }
        .prod-info {
            padding: 18px;
        }
        .prod-subcat {
            font-size: 0.7rem;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--clay);
            margin-bottom: 6px;
        }
        .prod-name {
            font-size: 1rem;
            font-weight: 500;
            margin-bottom: 6px;
            line-height: 1.3;
        }
        .prod-price {
            font-size: 0.9rem;
            color: var(--grey);
            margin-bottom: 8px;
        }
        .btn-add {
            width: 100%;
            padding: 10px;
            background: transparent;
            border: 1px solid var(--charcoal);
            border-radius: 40px;
            font-size: 0.85rem;
            cursor: pointer;
            transition: var(--ease);
            margin-top: 10px;
        }
        .btn-add:hover {
            background: var(--charcoal);
            color: white;
        }
        .empty-state {
            text-align: center;
            padding: 80px 20px;
            grid-column: 1/-1;
        }
        .empty-state i {
            font-size: 3rem;
            color: var(--linen);
            margin-bottom: 20px;
        }
        .breadcrumb {
            background: transparent;
            padding: 20px 0 0;
            margin-bottom: 0;
        }
        .breadcrumb a {
            color: var(--grey);
            text-decoration: none;
        }
        .breadcrumb a:hover {
            color: var(--charcoal);
        }

        .pagination-wrap {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin-top: 20px;
            margin-bottom: 60px;
        }
        .page-btn {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--sand);
            background: white;
            color: var(--grey);
            text-decoration: none;
            border-radius: 8px;
            transition: var(--ease);
        }
        .page-btn:hover {
            border-color: var(--charcoal);
            color: var(--charcoal);
        }
        .page-btn.active {
            background: var(--charcoal);
            color: white;
            border-color: var(--charcoal);
        }
        .page-btn.disabled {
            opacity: 0.4;
            pointer-events: none;
        }

        @media (max-width: 768px) {
            .cat-grid {
                grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
                gap: 12px;
            }
            .cat-card {
                padding: 16px 12px;
            }
            .cat-icon {
                font-size: 1.4rem;
            }
            .prod-grid {
                grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
                gap: 16px;
            }
            .cat-tab {
                padding: 10px 16px;
                font-size: 0.75rem;
            }
        }
    </style>
</head>
<body>
    <%- include('partials/header') %>

    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">Furniture</li>
            </ol>
        </nav>
    </div>

    <section class="page-hero">
        <span class="eyebrow">Luxury Furniture</span>
        <h1>Exceptional pieces for the modern home</h1>
        <p class="subtitle">Discover our curated collection of sofas, armchairs, tables, and storage</p>
    </section>

    <div class="category-tabs">
        <div class="inner">
            <button class="cat-tab active" data-category="all">All Furniture</button>
            <button class="cat-tab" data-category="sofas">Sofas</button>
            <button class="cat-tab" data-category="armchairs">Armchairs</button>
            <button class="cat-tab" data-category="coffee tables">Coffee Tables</button>
            <button class="cat-tab" data-category="sideboards">Sideboards</button>
            <button class="cat-tab" data-category="bookshelves">Bookshelves</button>
        </div>
    </div>

    <div class="container">
        <div class="cat-grid">
            <div class="cat-card active" data-category="all">
                <div class="cat-icon"><i class="fas fa-couch"></i></div>
                <div class="cat-name">All Furniture</div>
                <div class="cat-count"><%= products ? products.length : 0 %> items</div>
            </div>
            <div class="cat-card" data-category="sofas">
                <div class="cat-icon"><i class="fas fa-couch"></i></div>
                <div class="cat-name">Sofas</div>
                <div class="cat-count"><%= sofasCount || 0 %> items</div>
            </div>
            <div class="cat-card" data-category="armchairs">
                <div class="cat-icon"><i class="fas fa-chair"></i></div>
                <div class="cat-name">Armchairs</div>
                <div class="cat-count"><%= armchairsCount || 0 %> items</div>
            </div>
            <div class="cat-card" data-category="coffee tables">
                <div class="cat-icon"><i class="fas fa-table"></i></div>
                <div class="cat-name">Coffee Tables</div>
                <div class="cat-count"><%= coffeeTablesCount || 0 %> items</div>
            </div>
            <div class="cat-card" data-category="sideboards">
                <div class="cat-icon"><i class="fas fa-warehouse"></i></div>
                <div class="cat-name">Sideboards</div>
                <div class="cat-count"><%= sideboardsCount || 0 %> items</div>
            </div>
            <div class="cat-card" data-category="bookshelves">
                <div class="cat-icon"><i class="fas fa-book"></i></div>
                <div class="cat-name">Bookshelves</div>
                <div class="cat-count"><%= bookshelvesCount || 0 %> items</div>
            </div>
        </div>

        <div class="sort-wrap">
            <div class="dropdown">
                <button class="sort-btn dropdown-toggle" data-bs-toggle="dropdown">
                    Sort: 
                    <% if (filters && filters.sort === 'price_low') { %>Price: Low–High
                    <% } else if (filters && filters.sort === 'price_high') { %>Price: High–Low
                    <% } else if (filters && filters.sort === 'newest') { %>Newest
                    <% } else { %>Featured<% } %>
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="?sort=featured&category=<%= filters && filters.category ? filters.category : 'all' %>">Featured</a></li>
                    <li><a class="dropdown-item" href="?sort=newest&category=<%= filters && filters.category ? filters.category : 'all' %>">Newest</a></li>
                    <li><a class="dropdown-item" href="?sort=price_low&category=<%= filters && filters.category ? filters.category : 'all' %>">Price: Low–High</a></li>
                    <li><a class="dropdown-item" href="?sort=price_high&category=<%= filters && filters.category ? filters.category : 'all' %>">Price: High–Low</a></li>
                </ul>
            </div>
        </div>

        <div class="prod-grid" id="productsGrid">
            <% if (products && products.length > 0) { %>
                <% products.forEach(p => { %>
                <a href="/product/<%= p._id %>" class="prod-card" data-subcategory="<%= p.subcategory || '' %>">
                    <div class="prod-img">
                        <% if (p.images && p.images[0]) { %>
                            <img src="<%= p.images[0].url %>" alt="<%= p.name %>">
                        <% } else { %>
                            <div class="no-img" style="display: flex; align-items: center; justify-content: center; height: 100%;">
                                <i class="fas fa-couch fa-3x" style="color:#ccc;"></i>
                            </div>
                        <% } %>
                    </div>
                    <div class="prod-info">
                        <div class="prod-subcat"><%= p.subcategory || p.category %></div>
                        <div class="prod-name"><%= p.name %></div>
                        <div class="prod-price">₦<%= Number(p.discountPrice || p.price).toLocaleString() %></div>
                        <button class="btn-add add-to-cart-btn" data-id="<%= p._id %>" onclick="event.stopPropagation(); addToCart(event, '<%= p._id %>')" <%= p.stock === 0 ? 'disabled' : '' %>>
                            <%= p.stock === 0 ? 'Out of Stock' : 'Add to Cart' %>
                        </button>
                    </div>
                </a>
                <% }) %>
            <% } else { %>
                <div class="empty-state">
                    <i class="fas fa-couch"></i>
                    <h3>Coming Soon</h3>
                    <p>Our luxury furniture collection is being curated. Check back soon!</p>
                    <p style="margin-top: 20px; font-size: 0.9rem;">Sofas | Armchairs | Coffee Tables | Sideboards | Bookshelves | and more</p>
                </div>
            <% } %>
        </div>

        <% if (pagination && pagination.totalPages > 1) { %>
        <div class="pagination-wrap">
            <% if (pagination.hasPrev) { %>
                <a class="page-btn" href="?page=<%= pagination.prevPage %>&sort=<%= filters && filters.sort ? filters.sort : 'featured' %>&category=<%= filters && filters.category ? filters.category : 'all' %>">&lsaquo;</a>
            <% } else { %>
                <span class="page-btn disabled">&lsaquo;</span>
            <% } %>
            
            <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                <% if (i === 1 || i === pagination.totalPages || (i >= pagination.currentPage - 1 && i <= pagination.currentPage + 1)) { %>
                    <a class="page-btn <%= i === pagination.currentPage ? 'active' : '' %>" 
                       href="?page=<%= i %>&sort=<%= filters && filters.sort ? filters.sort : 'featured' %>&category=<%= filters && filters.category ? filters.category : 'all' %>"><%= i %></a>
                <% } else if (i === pagination.currentPage - 2 || i === pagination.currentPage + 2) { %>
                    <span class="page-btn disabled">…</span>
                <% } %>
            <% } %>
            
            <% if (pagination.hasNext) { %>
                <a class="page-btn" href="?page=<%= pagination.nextPage %>&sort=<%= filters && filters.sort ? filters.sort : 'featured' %>&category=<%= filters && filters.category ? filters.category : 'all' %>">&rsaquo;</a>
            <% } else { %>
                <span class="page-btn disabled">&rsaquo;</span>
            <% } %>
        </div>
        <% } %>
    </div>

    <%- include('partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const tabs = document.querySelectorAll('.cat-tab');
        const catCards = document.querySelectorAll('.cat-card');
        const products = document.querySelectorAll('.prod-card');

        tabs.forEach(tab => {
            tab.addEventListener('click', () => {
                const category = tab.dataset.category;
                
                tabs.forEach(t => t.classList.remove('active'));
                tab.classList.add('active');
                
                catCards.forEach(card => {
                    if (card.dataset.category === category) {
                        card.classList.add('active');
                    } else {
                        card.classList.remove('active');
                    }
                });
                
                const url = new URL(window.location.href);
                if (category === 'all') {
                    url.searchParams.delete('category');
                } else {
                    url.searchParams.set('category', category);
                }
                window.location.href = url.toString();
            });
        });

        catCards.forEach(card => {
            card.addEventListener('click', () => {
                const category = card.dataset.category;
                
                catCards.forEach(c => c.classList.remove('active'));
                card.classList.add('active');
                
                tabs.forEach(tab => {
                    if (tab.dataset.category === category) {
                        tab.classList.add('active');
                    } else {
                        tab.classList.remove('active');
                    }
                });
                
                const url = new URL(window.location.href);
                if (category === 'all') {
                    url.searchParams.delete('category');
                } else {
                    url.searchParams.set('category', category);
                }
                window.location.href = url.toString();
            });
        });

        async function addToCart(event, productId) {
            event.preventDefault();
            event.stopPropagation();
            
            const button = event.target;
            const originalText = button.textContent;
            button.disabled = true;
            button.textContent = 'Adding...';

            try {
                const response = await fetch('/cart/add', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({ productId, quantity: 1 })
                });

                const data = await response.json();

                if (data.success) {
                    button.textContent = '✓ Added';
                    setTimeout(() => {
                        button.textContent = originalText;
                        button.disabled = false;
                    }, 1500);
                } else {
                    alert(data.message || 'Could not add to cart');
                    button.textContent = originalText;
                    button.disabled = false;
                }
            } catch (err) {
                console.error('Error:', err);
                alert('Error adding to cart');
                button.textContent = originalText;
                button.disabled = false;
            }
        }
    </script>
</body>
</html>