<style>
    /* Modern expanding search bar */
    .search-container {
        position: relative;
        display: inline-block;
    }
    
    .expanding-search {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) scale(0.9);
        width: 0;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 10000;
    }
    
    .expanding-search.active {
        width: 90%;
        max-width: 600px;
        opacity: 1;
        visibility: visible;
        transform: translate(-50%, -50%) scale(1);
    }
    
    .search-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.15);
        overflow: hidden;
    }
    
    .search-header {
        padding: 1rem 1.5rem;
        background: var(--color-charcoal);
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    
    .search-header h4 {
        margin: 0;
        font-size: 1rem;
        color: white;
    }
    
    .close-search-btn {
        background: none;
        border: none;
        color: white;
        font-size: 1.2rem;
        cursor: pointer;
        padding: 0;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        transition: all 0.2s;
    }
    
    .close-search-btn:hover {
        background: rgba(255,255,255,0.2);
        transform: rotate(90deg);
    }
    
    .search-body {
        padding: 1.5rem;
    }
    
    .search-input-group {
        position: relative;
        margin-bottom: 1rem;
    }
    
    .search-input-group i {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--color-grey);
    }
    
    .search-input-group input {
        width: 100%;
        padding: 12px 15px 12px 45px;
        font-size: 1rem;
        border: 1px solid var(--color-sand);
        border-radius: 8px;
        outline: none;
        transition: all 0.2s;
        font-family: var(--font-sans);
    }
    
    .search-input-group input:focus {
        border-color: var(--color-clay);
        box-shadow: 0 0 0 3px rgba(166,138,111,0.1);
    }
    
    .search-results {
        max-height: 300px;
        overflow-y: auto;
    }
    
    .search-result-item {
        padding: 12px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    
    .search-result-item:hover {
        background: var(--color-stone);
        transform: translateX(5px);
    }
    
    .search-result-icon {
        width: 40px;
        height: 40px;
        background: var(--color-stone);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-clay);
    }
    
    .search-result-info h4 {
        margin: 0;
        font-size: 0.95rem;
        font-weight: 500;
    }
    
    .search-result-info p {
        margin: 0;
        font-size: 0.8rem;
        color: var(--color-grey);
    }
    
    /* Overlay background */
    .search-overlay-bg {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.5);
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s ease;
        z-index: 9999;
        backdrop-filter: blur(4px);
    }
    
    .search-overlay-bg.active {
        opacity: 1;
        visibility: visible;
    }
    
    @media (max-width: 768px) {
        .expanding-search.active {
            width: 95%;
        }
    }

    /* Results inside search panel */
    .search-results-panel {
        max-height: 420px;
        overflow-y: auto;
        padding: 8px 0;
    }
    .search-results-panel:empty { display: none; }

    .search-section-label {
        padding: 8px 20px 4px;
        font-size: 0.68rem;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #A68A6F;
        font-weight: 500;
    }

    .search-result-item {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 10px 20px;
        cursor: pointer;
        transition: background 0.15s;
        text-decoration: none;
        color: inherit;
    }
    .search-result-item:hover { background: #faf9f7; }
    .search-result-item:last-child { border-bottom: none; }

    .sri-thumb {
        width: 46px; height: 46px;
        border-radius: 8px;
        object-fit: cover;
        background: #f5f3f0;
        flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
        overflow: hidden;
    }
    .sri-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 8px; }
    .sri-thumb i { color: #A68A6F; font-size: 1.2rem; }

    .sri-body { flex: 1; min-width: 0; }
    .sri-title {
        font-size: 0.9rem;
        font-weight: 500;
        color: #2D2D2D;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: 2px;
    }
    .sri-sub { font-size: 0.75rem; color: #999; }
    .sri-price {
        font-size: 0.9rem;
        font-weight: 500;
        color: #A68A6F;
        flex-shrink: 0;
    }

    .search-footer {
        border-top: 1px solid #f0ece6;
        padding: 12px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .search-footer-tip { font-size: 0.78rem; color: #b0a898; }
    .search-footer-tip kbd {
        background: #f5f3f0;
        border: 1px solid #e0dbd5;
        border-radius: 4px;
        padding: 1px 5px;
        font-size: 0.7rem;
        font-family: monospace;
    }
    .view-all-link {
        font-size: 0.82rem;
        color: #2D2D2D;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-weight: 500;
    }
    .view-all-link:hover { color: #A68A6F; }

    .search-loading { display: flex; align-items: center; gap: 10px; padding: 20px; color: #999; font-size: 0.9rem; }
    .search-spinner { width: 18px; height: 18px; border: 2px solid #e0dbd5; border-top-color: #A68A6F; border-radius: 50%; animation: srSpin 0.6s linear infinite; }
    @keyframes srSpin { to { transform: rotate(360deg); } }

    .search-no-results {
        text-align: center;
        padding: 28px 20px;
        color: #999;
    }
    .search-no-results i { font-size: 2rem; color: #D9D1C7; margin-bottom: 10px; display: block; }
    .search-no-results p { margin: 0; font-size: 0.9rem; }

    /* Desktop nested dropdowns */
    .dropdown-submenu { position: relative; }
    .dropdown-submenu .dropdown-menu { top: 0; left: 100%; margin-top: -1px; }
    .dropdown-submenu:hover > .dropdown-menu { display: block; }
    .dropend .dropdown-menu { top: 0; right: auto; left: 100%; }
    .dropdown-submenu span.dropdown-item { cursor: pointer; }
    .dropdown-submenu span.dropdown-item:hover { background-color: #f8f9fa; }

    @media (max-width: 991px) {
        .navbar-nav .dropdown-menu { background:#fff; border:1px solid rgba(0,0,0,0.15); border-radius:.5rem; padding:.5rem 0; margin-top:.5rem; }
        .navbar-nav span.dropdown-toggle { display:block; padding:.5rem 1rem; color:rgba(0,0,0,.55); text-decoration:none; cursor:pointer; }
        .navbar-nav span.dropdown-toggle:hover { color:rgba(0,0,0,.7); }
    }
</style>

