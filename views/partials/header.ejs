<!-- views/partials/header.ejs -->
<!-- Navigation -->
<nav class="navbar navbar-expand-lg navbar-light fixed-top">
    <div class="container-fluid">
        <!-- Desktop Dropdown Container -->
        <div class="desktop-dropdown-container">
            <div class="desktop-dropdown">
                <button class="btn dropdown-toggle d-flex align-items-center" type="button" id="desktopDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="navbar-toggler-icon me-2"></span>
                </button>
                <ul class="dropdown-menu" aria-labelledby="desktopDropdown">
                    <li><a class="dropdown-item" href="/">Home</a></li>                    
                    <li><a class="dropdown-item" href="/interiors">Interiors</a></li>
                    
                    <!-- Shop as dropdown only (not a link) -->
                    <li class="dropdown-submenu dropend">
                        <span class="dropdown-item dropdown-toggle" style="cursor: pointer;">Shop</span>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/decor">Decor</a></li>
                            <li><a class="dropdown-item" href="/bedding">Bedding</a></li>
                            <li><a class="dropdown-item" href="/furniture">Furniture</a></li>
                        </ul>
                    </li>
                    
                    <li><a class="dropdown-item" href="/blog">Blog</a></li>
                    <li><a class="dropdown-item" href="/portfolio">Portfolio</a></li>
                    <li><a class="dropdown-item" href="/about">About</a></li>
                    <li><a class="dropdown-item" href="/contact">Subscribe</a></li>
                </ul>
            </div>
        </div>

        <!-- Centered Logo -->
        <a class="navbar-brand mx-auto" href="/" aria-label="UZYHOMES Home">
            <img 
                src="/images/UzyHomes.png" 
                alt="UZYHOMES"
                class="brand-logo"
                loading="eager"
            >
        </a>

        <!-- Desktop Icons Container -->
        <div class="desktop-icons">
            <a href="#" class="nav-icon me-3 search-icon">
                <i class="fas fa-search"></i>
            </a>
            <a href="/cart" class="nav-icon me-4 position-relative">
                <i class="fas fa-shopping-bag"></i>
                <span class="cart-count" id="cartCount">0</span>
            </a>
            <% if (!user) { %>
                <a href="/login" class="nav-icon me-3" aria-label="Login">
                    <i class="fas fa-user"></i>
                </a>
            <% } else { %>
                <div class="dropdown">
                    <a href="#" class="nav-icon me-3 dropdown-toggle" data-bs-toggle="dropdown" aria-label="Account" id="userDropdown">
                        <i class="fas fa-user"></i>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                        <li><a class="dropdown-item" href="/account">My Account</a></li>
                        <li><a class="dropdown-item" href="/orders">Orders</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="#" id="logoutBtn">Logout</a></li>
                    </ul>
                </div>
            <% } %>
            <a href="/contact" class="btn-book ms-2">Book Consultation</a>
        </div>

        <!-- Mobile Icons Container -->
        <div class="mobile-icons">
            <a href="#" class="nav-icon me-3 search-icon">
                <i class="fas fa-search"></i>
            </a>
            <a href="/cart" class="nav-icon me-3 position-relative">
                <i class="fas fa-shopping-bag"></i>
                <span class="cart-count" id="mobileCartCount">0</span>
            </a>
            <button class="navbar-toggler border-0 p-0" type="button" data-bs-toggle="collapse" data-bs-target="#mobileNav" aria-controls="mobileNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
        </div>
    </div>

    <!-- Mobile Dropdown Menu -->
    <div class="collapse navbar-collapse" id="mobileNav">
        <div class="container-fluid py-3">
            <ul class="navbar-nav">
                <li class="nav-item"><a class="nav-link" href="/">Home</a></li>                
                <li class="nav-item"><a class="nav-link" href="/interiors">Interiors</a></li>
                
                <!-- Shop as dropdown only for mobile (not a link) -->
                <li class="nav-item dropdown">
                    <span class="nav-link dropdown-toggle" style="cursor: pointer;" id="mobileShopDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Shop
                    </span>
                    <ul class="dropdown-menu" aria-labelledby="mobileShopDropdown">
                        <li><a class="dropdown-item" href="/decor">Decor</a></li>
                        <li><a class="dropdown-item" href="/bedding">Bedding</a></li>
                        <li><a class="dropdown-item" href="/furniture">Furniture</a></li>
                    </ul>
                </li>
                
                <li class="nav-item"><a class="nav-link" href="/blog">Blog</a></li>
                <li class="nav-item"><a class="nav-link" href="/portfolio">Portfolio</a></li>
                <li class="nav-item"><a class="nav-link" href="/about">About</a></li>
                <li class="nav-item"><a class="nav-link" href="/contact">Subscribe</a></li>
            </ul>
            
            <div class="d-flex flex-column mt-3 pt-3 border-top">
                <% if (!user) { %>
                    <a href="/login" class="nav-link mb-2">
                        <i class="fas fa-user me-2"></i>Login
                    </a>
                <% } else { %>
                    <a href="/account" class="nav-link mb-2">
                        <i class="fas fa-user me-2"></i>My Account
                    </a>
                    <a href="#" class="nav-link mb-2" id="mobileLogoutBtn">
                        <i class="fas fa-sign-out-alt me-2"></i>Logout
                    </a>
                <% } %>
                <a href="/contact" class="btn-book text-center mt-2">Book Consultation</a>
            </div>
        </div>
    </div>
</nav>

<style>
    /* Desktop nested dropdown on hover */
    .dropdown-submenu {
        position: relative;
    }
    
    .dropdown-submenu .dropdown-menu {
        top: 0;
        left: 100%;
        margin-top: -1px;
        margin-left: 0;
    }
    
    .dropdown-submenu:hover > .dropdown-menu {
        display: block;
    }
    
    .dropdown-submenu > .dropdown-toggle:active {
        pointer-events: none;
    }
    
    /* Make sure Shop text doesn't look like a link */
    .dropdown-submenu span.dropdown-item {
        cursor: pointer;
    }
    
    .dropdown-submenu span.dropdown-item:hover {
        background-color: #f8f9fa;
    }
    
    /* Adjust for RTL if needed */
    .dropend .dropdown-menu {
        top: 0;
        right: auto;
        left: 100%;
    }
</style>

<!-- Pass user data to JavaScript -->
<script>
    window.userData = {
        isLoggedIn: <%= user ? 'true' : 'false' %>,
        <% if (user) { %>
        id: '<%= user._id %>',
        email: '<%= user.email %>',
        firstName: '<%= user.firstName %>',
        lastName: '<%= user.lastName %>'
        <% } %>
    };
    console.log('Header loaded - User logged in:', window.userData.isLoggedIn);
</script>