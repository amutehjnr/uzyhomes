<!-- ── Search Overlay ───────────────────────────────────────────────────── -->
<div class="search-overlay-bg" id="searchOverlayBg"></div>

<div class="expanding-search" id="expandingSearch">
    <div class="search-card">
        <!-- Input row -->
        <div class="search-card-header">
            <i class="fas fa-search"></i>
            <input type="text" id="headerSearchInput"
                   placeholder="Search products, blog posts, pages…"
                   autocomplete="off" spellcheck="false">
            <button class="close-search-btn" id="closeSearchBtn" aria-label="Close search">✕</button>
        </div>

        <!-- Live results -->
        <div class="search-results-panel" id="searchResultsPanel"></div>

        <!-- Footer tips -->
        <div class="search-footer">
            <span class="search-footer-tip">
                <kbd>↵</kbd> to search &nbsp; <kbd>ESC</kbd> to close
            </span>
            <a href="#" class="view-all-link" id="viewAllLink" style="display:none">
                View all results <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    </div>
</div>

<!-- User data for JS -->
