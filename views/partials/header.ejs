<style>
    /* Desktop nested dropdown on hover */
    .dropdown-submenu {
        position: relative;
    }
    
    .dropdown-submenu .dropdown-menu {
        top: 0;
        left: 100%;
        margin-top: -1px;
        margin-left: 0;
    }
    
    .dropdown-submenu:hover > .dropdown-menu {
        display: block;
    }
    
    .dropdown-submenu > .dropdown-toggle:active {
        pointer-events: none;
    }
    
    /* Make sure Shop text doesn't look like a link */
    .dropdown-submenu span.dropdown-item {
        cursor: pointer;
    }
    
    .dropdown-submenu span.dropdown-item:hover {
        background-color: #f8f9fa;
    }
    
    /* Adjust for RTL if needed */
    .dropend .dropdown-menu {
        top: 0;
        right: auto;
        left: 100%;
    }

    /* Mobile specific styles */
    @media (max-width: 991px) {
        /* Ensure dropdowns are properly styled on mobile */
        .navbar-nav .dropdown-menu {
            background-color: #fff;
            border: 1px solid rgba(0,0,0,0.15);
            border-radius: 0.5rem;
            padding: 0.5rem 0;
            margin-top: 0.5rem;
        }
        
        .dropdown-item {
            padding: 0.5rem 1.5rem;
        }
        
        .dropdown-item:hover {
            background-color: #f8f9fa;
        }
        
        /* Make span dropdown-toggle look like nav-link */
        .navbar-nav .nav-link.dropdown-toggle,
        .navbar-nav span.dropdown-toggle {
            display: block;
            padding: 0.5rem 1rem;
            color: rgba(0,0,0,0.55);
            text-decoration: none;
        }
        
        .navbar-nav span.dropdown-toggle {
            cursor: pointer;
        }
        
        .navbar-nav span.dropdown-toggle:hover {
