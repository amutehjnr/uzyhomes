        email: '<%= user.email %>',
        firstName: '<%= user.firstName %>',
        lastName: '<%= user.lastName %>'
        <% } %>
    };
</script>

<script>
/* ── Cart count ────────────────────────────────────────────── */
(async function updateCartCount() {
    try {
        const res  = await fetch('/cart/count', { credentials: 'same-origin' });
        const data = await res.json();
        const count = data.count || 0;
        document.querySelectorAll('#cartCount, #mobileCartCount').forEach(el => {
            el.textContent = count;
            el.style.display = count > 0 ? 'flex' : 'none';
        });
    } catch (e) { console.error('Cart count error:', e); }
})();

/* ── Logout ─────────────────────────────────────────────────── */
['logoutBtn','mobileLogoutBtn'].forEach(id => {
    document.getElementById(id)?.addEventListener('click', async e => {
        e.preventDefault();
        try {
            await fetch('/api/auth/logout', { method: 'POST' });
        } catch(e) {}
        localStorage.removeItem('token');
        localStorage.removeItem('user');
        window.location.href = '/';
    });
});

/* ── Mobile Shop dropdown ────────────────────────────────────── */
document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('mobileShopDropdown')?.addEventListener('click', e => {
        e.preventDefault();
        e.stopPropagation();
    });

    document.querySelectorAll('#mobileNav .dropdown-menu').forEach(m => {
        m.addEventListener('click', e => e.stopPropagation());
    });
});

/* ══════════════════════════════════════════════════════════════
   SEARCH ENGINE
═══════════════════════════════════════════════════════════════ */
(function() {
    const overlay     = document.getElementById('searchOverlayBg');
    const searchBox   = document.getElementById('expandingSearch');
    const input       = document.getElementById('headerSearchInput');
    const panel       = document.getElementById('searchResultsPanel');
    const closeBtn    = document.getElementById('closeSearchBtn');
    const viewAllLink = document.getElementById('viewAllLink');

    let debounceTimer = null;
    let currentQuery  = '';

    /* Open / close */
    function openSearch() {
        overlay.classList.add('active');
        searchBox.classList.add('active');
        document.body.style.overflow = 'hidden';
        setTimeout(() => input.focus(), 120);
    }

    function closeSearch() {
        overlay.classList.remove('active');
        searchBox.classList.remove('active');
        document.body.style.overflow = '';
        input.value = '';
        currentQuery = '';
        panel.innerHTML = '';
        viewAllLink.style.display = 'none';
    }

    /* Triggers */
    document.querySelectorAll('.search-trigger').forEach(btn => {
        btn.addEventListener('click', e => { e.preventDefault(); openSearch(); });
    });
    closeBtn.addEventListener('click', closeSearch);
    overlay.addEventListener('click', closeSearch);
    document.addEventListener('keydown', e => {
        if (e.key === 'Escape') closeSearch();
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') { e.preventDefault(); openSearch(); }
    });

    /* Input handler */
    input.addEventListener('input', () => {
        const q = input.value.trim();

        clearTimeout(debounceTimer);

        if (q.length < 2) {
            panel.innerHTML = '';
            viewAllLink.style.display = 'none';
            return;
        }

        // Show loader immediately
        panel.innerHTML = `<div class="search-loading">
            <div class="search-spinner"></div>
            <span>Searching…</span>
        </div>`;

        debounceTimer = setTimeout(() => fetchLiveResults(q), 280);
    });

    /* Enter = go to full search page */
    input.addEventListener('keydown', e => {
        if (e.key === 'Enter') {
            const q = input.value.trim();
            if (q.length >= 2) {
                window.location.href = `/search?q=${encodeURIComponent(q)}`;
            }
        }
    });

    /* Live search fetch */
    async function fetchLiveResults(q) {
        if (q === currentQuery) return;
        currentQuery = q;

        try {
            const res  = await fetch(`/api/search?q=${encodeURIComponent(q)}&limit=8`);
            const data = await res.json();

            if (q !== currentQuery) return; // stale

            if (!data.success || !data.results || data.results.length === 0) {
                renderNoResults(q);
                return;
            }

            renderLiveResults(data.results, q, data.total);

        } catch (err) {
            console.error('Live search error:', err);
            panel.innerHTML = `<div class="search-no-results"><i class="fas fa-exclamation-circle"></i><p>Search unavailable. <a href="/search?q=${encodeURIComponent(q)}">Try full search →</a></p></div>`;
        }
    }

    /* Render helpers */
    function renderNoResults(q) {
        panel.innerHTML = `<div class="search-no-results">
            <i class="fas fa-search"></i>
            <p>No results for "<strong>${esc(q)}</strong>". <a href="/search?q=${encodeURIComponent(q)}" style="color:#A68A6F">Browse all →</a></p>
        </div>`;
        viewAllLink.style.display = 'none';
    }

    function renderLiveResults(results, q, total) {
        const products = results.filter(r => r.type === 'Product');
        const blogs    = results.filter(r => r.type === 'Blog');
        const pages    = results.filter(r => r.type === 'Page');

        let html = '';

        if (products.length) {
            html += `<div class="search-section-label">Products</div>`;
            html += products.map(r => itemHtml(r)).join('');
        }
        if (blogs.length) {
            html += `<div class="search-section-label">Blog Posts</div>`;
            html += blogs.map(r => itemHtml(r)).join('');
        }
        if (pages.length) {
            html += `<div class="search-section-label">Pages</div>`;
            html += pages.map(r => itemHtml(r)).join('');
        }

        panel.innerHTML = html;

        // View-all link
        viewAllLink.style.display = 'flex';
        viewAllLink.href = `/search?q=${encodeURIComponent(q)}`;
        viewAllLink.innerHTML = `View all ${total} results <i class="fas fa-arrow-right" style="margin-left:4px"></i>`;
    }

    function itemHtml(r) {
        const thumbHtml = r.image
            ? `<div class="sri-thumb"><img src="${esc(r.image)}" alt="${esc(r.title)}" loading="lazy"></div>`
            : `<div class="sri-thumb"><i class="fas ${typeIcon(r.type)}"></i></div>`;

        const priceHtml = r.type === 'Product' && r.price
            ? `<span class="sri-price">₦${Number(r.price).toLocaleString()}</span>`
            : '';

        return `<a class="search-result-item" href="${esc(r.url)}">
            ${thumbHtml}
            <div class="sri-body">
                <div class="sri-title">${highlightText(esc(r.title), currentQuery)}</div>
                <div class="sri-sub">${esc(r.subtitle || r.type)}</div>
            </div>
            ${priceHtml}
        </a>`;
    }

    function typeIcon(type) {
        return { Product: 'fa-tag', Blog: 'fa-newspaper', Page: 'fa-file' }[type] || 'fa-circle';
    }

    function highlightText(text, q) {
        if (!q || q.length < 2) return text;
        const safe = q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        return text.replace(new RegExp(`(${safe})`, 'gi'), '<mark style="background:#fff3cd;padding:0 2px;border-radius:2px">$1</mark>');
    }

    function esc(s) {
        const m = { '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;' };
        return String(s || '').replace(/[&<>"']/g, c => m[c]);
    }

})();
</script>
