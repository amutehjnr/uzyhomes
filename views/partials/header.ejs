<!-- Pass user data to JavaScript -->
<script>
    window.userData = {
        isLoggedIn: <%= user ? 'true' : 'false' %>,
        <% if (user) { %>
        id: '<%= user._id %>',
        email: '<%= user.email %>',
        firstName: '<%= user.firstName %>',
        lastName: '<%= user.lastName %>'
        <% } %>
    };
    console.log('Header loaded - User logged in:', window.userData.isLoggedIn);
    
    // Prevent navbar collapse when clicking on Shop dropdown
    document.addEventListener('DOMContentLoaded', function() {
        // Get the mobile shop dropdown element
        const mobileShopDropdown = document.getElementById('mobileShopDropdown');
        
        if (mobileShopDropdown) {
            // Stop event propagation to prevent navbar collapse
            mobileShopDropdown.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
            });
        }
        
        // Also prevent collapse when clicking inside dropdown menu
        const dropdownMenus = document.querySelectorAll('#mobileNav .dropdown-menu');
        dropdownMenus.forEach(function(menu) {
            menu.addEventListener('click', function(e) {
                e.stopPropagation();
            });
        });
        
        // Re-initialize all dropdowns
        var dropdownElementList = [].slice.call(document.querySelectorAll('.dropdown-toggle'));
        dropdownElementList.map(function(dropdownToggleEl) {
            return new bootstrap.Dropdown(dropdownToggleEl);
        });
    });

    // Add inside the DOMContentLoaded block in header.ejs
async function updateCartCount() {
    try {
        const res = await fetch('/cart/count', { credentials: 'same-origin' });
        const data = await res.json();
        const count = data.count || 0;
        document.querySelectorAll('#cartCount, #mobileCartCount, .cart-count').forEach(el => {
            el.textContent = count;
            el.style.display = count > 0 ? 'flex' : 'none';
        });
    } catch (err) {
        console.error('Cart count error:', err);
    }
}

// Call on page load
updateCartCount();
</script>

<script>
// Modern expanding search functionality
document.addEventListener('DOMContentLoaded', function() {
    const searchOverlayBg = document.getElementById('searchOverlayBg');
    const expandingSearch = document.getElementById('expandingSearch');
    const searchInput = document.getElementById('searchInput');
    const closeSearchBtn = document.getElementById('closeSearchBtn');
    const searchResults = document.getElementById('searchResults');
    const searchIcons = document.querySelectorAll('.search-icon');
    
    let searchTimeout;
    
    // Open search
    function openSearch() {
        searchOverlayBg.classList.add('active');
        expandingSearch.classList.add('active');
        document.body.style.overflow = 'hidden';
        setTimeout(() => {
            searchInput.focus();
        }, 100);
    }
    
    // Close search
    function closeSearch() {
        searchOverlayBg.classList.remove('active');
        expandingSearch.classList.remove('active');
        document.body.style.overflow = '';
        searchInput.value = '';
        searchResults.innerHTML = '<div style="text-align: center; padding: 20px; color: var(--color-grey);">Start typing to search...</div>';
    }
    
    // Perform search (optional - add your search API here)
    async function performSearch(query) {
        if (query.length < 2) {
            searchResults.innerHTML = '<div style="text-align: center; padding: 20px; color: var(--color-grey);">Type at least 2 characters to search...</div>';
            return;
        }
        
        // Example search - replace with your actual search endpoint
        searchResults.innerHTML = '<div style="text-align: center; padding: 20px; color: var(--color-grey);"><i class="fas fa-spinner fa-spin"></i> Searching...</div>';
        
        try {
            const response = await fetch(`/api/search?q=${encodeURIComponent(query)}`);
            const data = await response.json();
            
            if (data.results && data.results.length > 0) {
                searchResults.innerHTML = data.results.map(result => `
                    <div class="search-result-item" data-url="${result.url}">
                        <div class="search-result-icon">
                            <i class="fas ${result.type === 'Product' ? 'fa-tag' : 'fa-newspaper'}"></i>
                        </div>
                        <div class="search-result-info">
                            <h4>${result.title}</h4>
                            <p>${result.type}</p>
                        </div>
                    </div>
                `).join('');
                
                // Add click handlers
                document.querySelectorAll('.search-result-item').forEach(item => {
                    item.addEventListener('click', () => {
                        window.location.href = item.dataset.url;
                    });
                });
            } else {
                searchResults.innerHTML = '<div style="text-align: center; padding: 20px; color: var(--color-grey);">No results found</div>';
            }
        } catch (error) {
            console.error('Search error:', error);
            searchResults.innerHTML = '<div style="text-align: center; padding: 20px; color: var(--color-grey);">Search error. Please try again.</div>';
        }
    }
    
    // Event listeners
    searchIcons.forEach(icon => {
        icon.addEventListener('click', (e) => {
            e.preventDefault();
            openSearch();
        });
    });
    
    closeSearchBtn.addEventListener('click', closeSearch);
    searchOverlayBg.addEventListener('click', closeSearch);
    
    searchInput.addEventListener('input', (e) => {
        clearTimeout(searchTimeout);
        const query = e.target.value.trim();
        searchTimeout = setTimeout(() => performSearch(query), 300);
    });
    
    // Close on Escape
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && expandingSearch.classList.contains('active')) {
            closeSearch();
        }
    });
});
</script>