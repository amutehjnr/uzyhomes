<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="UZYHOMES Collection — Luxury bedding, curated décor, and refined interiors designed with intention.">
    <title><%= title %></title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">

    <style>
        :root {
            --ivory: #FAF9F7;
            --stone: #F5F3F0;
            --sand: #E8E4DD;
            --charcoal: #2D2D2D;
            --grey: #777777;
            --clay: #A68A6F;
            --linen: #D9D1C7;
            --font-serif: 'Playfair Display', Georgia, serif;
            --font-sans: 'Inter', sans-serif;
            --ease: all 0.3s cubic-bezier(0.4,0,0.2,1);
        }

        body { font-family: var(--font-sans); font-weight: 300; color: var(--charcoal); background: var(--ivory); }

        /* ── Hero ── */
        .coll-hero {
            padding: 110px 0 56px;
            text-align: center;
            background: linear-gradient(to bottom, var(--stone), var(--ivory));
        }
        .coll-hero .eyebrow {
            font-size: 0.72rem; letter-spacing: 3px; text-transform: uppercase;
            color: var(--grey); margin-bottom: 14px; display: block;
        }
        .coll-hero h1 {
            font-family: var(--font-serif); font-size: clamp(2rem, 4.5vw, 3.2rem);
            font-weight: 400; max-width: 640px; margin: 0 auto 14px; line-height: 1.18;
        }
        .coll-hero .subtitle {
            font-size: 1rem; color: var(--grey); max-width: 440px; margin: 0 auto;
        }

        /* ── Filter bar ── */
        .filter-bar {
            background: white; border-bottom: 1px solid rgba(0,0,0,0.06);
            position: sticky; top: 70px; z-index: 100; overflow-x: auto;
            scrollbar-width: none;
        }
        .filter-bar::-webkit-scrollbar { display: none; }
        .filter-bar .inner { display: flex; padding: 0 24px; gap: 0; }
        .ftab {
            padding: 14px 18px; font-size: 0.82rem; letter-spacing: 0.5px;
            border: none; background: none; color: var(--grey); cursor: pointer;
            white-space: nowrap; border-bottom: 2px solid transparent;
            transition: var(--ease);
        }
        .ftab:hover { color: var(--charcoal); }
        .ftab.active { color: var(--charcoal); border-bottom-color: var(--charcoal); font-weight: 500; }

        /* ── Section labels ── */
        .section-eyebrow {
            font-size: 0.72rem; letter-spacing: 2.5px; text-transform: uppercase;
            color: var(--grey); display: block; margin-bottom: 6px;
        }
        .section-title {
            font-family: var(--font-serif); font-size: clamp(1.4rem, 2.5vw, 2rem);
            font-weight: 400; margin-bottom: 6px;
        }
        .section-lead { font-size: 0.95rem; color: var(--grey); }

        /* ── Sort dropdown ── */
        .sort-wrap { display: flex; justify-content: flex-end; margin-bottom: 24px; }
        .sort-btn {
            padding: 9px 18px; font-size: 0.82rem; border: 1px solid var(--sand);
            background: white; cursor: pointer; color: var(--charcoal);
            transition: var(--ease);
        }
        .sort-btn:hover { border-color: var(--charcoal); }

        /* ── Featured grid ── */
        .feat-grid {
            display: grid; grid-template-columns: 1fr 1fr;
            grid-template-rows: auto auto; gap: 14px; margin-bottom: 64px;
        }
        .feat-card {
            position: relative; overflow: hidden; background: var(--stone);
            border-radius: 10px; cursor: pointer; text-decoration: none; display: block;
        }
        .feat-card.big { grid-row: span 2; min-height: 480px; }
        .feat-card.sm  { min-height: 226px; }
        .feat-card .img-wrap, .feat-card .img-wrap img {
            width: 100%; height: 100%; object-fit: cover;
        }
        .feat-card .img-placeholder {
            width: 100%; min-height: inherit;
            display: flex; align-items: center; justify-content: center;
        }
        .feat-card .card-label {
            position: absolute; bottom: 0; left: 0; right: 0; padding: 20px;
            background: linear-gradient(transparent, rgba(0,0,0,0.55)); color: white;
        }
        .feat-card .card-label .cat { font-size: 0.62rem; letter-spacing: 2px; text-transform: uppercase; opacity: 0.8; margin-bottom: 3px; }
        .feat-card .card-label .name { font-family: var(--font-serif); font-size: 1rem; font-weight: 400; }
        .feat-card .card-label .price { font-size: 0.82rem; margin-top: 3px; opacity: 0.9; }
        .feat-card img { transition: transform 0.5s ease; }
        .feat-card:hover img { transform: scale(1.04); }

        /* ── Bedding collections strip ── */
        .coll-strip {
            display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 14px; margin-bottom: 64px;
        }
        .coll-strip-card {
            position: relative; overflow: hidden; border-radius: 10px;
            min-height: 200px; cursor: pointer; text-decoration: none; display: block;
            background: var(--stone);
        }
        .coll-strip-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
        .coll-strip-card:hover img { transform: scale(1.05); }
        .coll-strip-card .overlay {
            position: absolute; bottom: 0; left: 0; right: 0; padding: 18px;
            background: linear-gradient(transparent, rgba(0,0,0,0.6)); color: white;
        }
        .coll-strip-card .overlay h4 { font-family: var(--font-serif); font-size: 1.1rem; font-weight: 400; margin-bottom: 2px; }
        .coll-strip-card .overlay p { font-size: 0.8rem; opacity: 0.85; margin: 0; }

        /* ── Story band ── */
        .story-band {
            background: white; border-top: 1px solid rgba(0,0,0,0.05);
            border-bottom: 1px solid rgba(0,0,0,0.05);
            padding: 64px 0; margin: 48px 0;
        }
        .story-img {
            background: var(--stone); border-radius: 10px;
            min-height: 320px; overflow: hidden;
            display: flex; align-items: center; justify-content: center;
        }
        .story-img img { width: 100%; height: 100%; object-fit: cover; border-radius: 10px; }

        /* ── Product grid ── */
        .prod-grid {
            display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 16px;
        }
        .prod-card {
            background: white; border-radius: 10px;
            border: 1px solid rgba(0,0,0,0.05); overflow: hidden;
            transition: box-shadow 0.3s ease, transform 0.3s ease;
        }
        .prod-card:hover { transform: translateY(-4px); box-shadow: 0 10px 30px rgba(0,0,0,0.08); }
        .prod-img { aspect-ratio: 1/1; background: var(--stone); overflow: hidden; }
        .prod-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
        .prod-card:hover .prod-img img { transform: scale(1.04); }
        .prod-img .no-img { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; min-height: 180px; }
        .prod-info { padding: 14px 16px 16px; }
        .prod-cat { font-size: 0.62rem; letter-spacing: 1.5px; text-transform: uppercase; color: var(--clay); margin-bottom: 4px; }
        .prod-name { font-size: 0.9rem; font-weight: 500; margin-bottom: 3px; line-height: 1.3; }
        .prod-price { font-size: 0.85rem; color: var(--grey); margin-bottom: 3px; }
        .prod-original { font-size: 0.8rem; color: #aaa; text-decoration: line-through; margin-left: 5px; }
        .prod-desc { font-size: 0.78rem; color: #999; line-height: 1.4; }
        .btn-add {
            margin-top: 10px; padding: 8px 16px; background: transparent;
            border: 1px solid var(--charcoal); border-radius: 40px;
            font-size: 0.8rem; cursor: pointer; width: 100%;
            transition: var(--ease);
        }
        .btn-add:hover { background: var(--charcoal); color: white; }
        .btn-add:disabled { opacity: 0.45; cursor: not-allowed; border-color: var(--sand); }

        /* ── Category pills ── */
        .cat-pills { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 28px; }
        .cat-pill {
            padding: 9px 20px; background: white; border: 1px solid rgba(0,0,0,0.08);
            border-radius: 40px; font-size: 0.82rem; cursor: pointer;
            transition: var(--ease); text-decoration: none; color: var(--charcoal);
        }
        .cat-pill:hover, .cat-pill.active { border-color: var(--charcoal); background: var(--charcoal); color: white; }

        /* ── Decor category cards ── */
        .decor-cat-grid {
            display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
            gap: 12px; margin-bottom: 40px;
        }
        .decor-cat-card {
            padding: 24px 16px; background: white; border-radius: 10px;
            text-align: center; text-decoration: none; color: var(--charcoal);
            border: 1px solid rgba(0,0,0,0.05); transition: var(--ease);
        }
        .decor-cat-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(0,0,0,0.08); }
        .decor-cat-card .dc-icon { font-size: 1.8rem; margin-bottom: 10px; color: var(--charcoal); }
        .decor-cat-card .dc-name { font-size: 0.9rem; font-weight: 500; margin-bottom: 2px; }
        .decor-cat-card .dc-count { font-size: 0.78rem; color: var(--grey); }

        /* ── Styling tips ── */
        .tip-card {
            padding: 24px; background: white; border-radius: 10px;
            height: 100%; border: 1px solid rgba(0,0,0,0.05);
            transition: var(--ease);
        }
        .tip-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(0,0,0,0.08); }
        .tip-number { font-size: 2rem; font-weight: 300; color: var(--linen); margin-bottom: 10px; line-height: 1; }
        .tip-card h4 { font-size: 1rem; font-weight: 500; margin-bottom: 6px; }
        .tip-card p { font-size: 0.9rem; color: var(--grey); margin: 0; }

        /* ── CTA ── */
        .cta-section { background: var(--stone); padding: 72px 0; text-align: center; }
        .cta-section h2 { font-family: var(--font-serif); font-size: clamp(1.6rem, 3vw, 2.4rem); font-weight: 400; margin-bottom: 16px; }
        .cta-section p { font-size: 1rem; color: var(--grey); max-width: 500px; margin: 0 auto 32px; }

        .btn-cta-dark {
            padding: 13px 32px; background: var(--charcoal); color: white;
            border: none; border-radius: 40px; font-size: 0.9rem;
            text-decoration: none; display: inline-block; transition: var(--ease);
        }
        .btn-cta-dark:hover { background: #444; color: white; transform: translateY(-2px); }
        .btn-cta-outline {
            padding: 13px 32px; background: transparent; color: var(--charcoal);
            border: 1px solid var(--charcoal); border-radius: 40px; font-size: 0.9rem;
            text-decoration: none; display: inline-block; transition: var(--ease);
        }
        .btn-cta-outline:hover { background: var(--charcoal); color: white; }

        /* ── Pagination ── */
        .pagination-wrap { display: flex; justify-content: center; gap: 6px; margin-top: 48px; }
        .page-btn {
            width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;
            border: 1px solid var(--sand); background: white; color: var(--grey);
            text-decoration: none; font-size: 0.88rem; border-radius: 4px; transition: var(--ease);
        }
        .page-btn:hover { border-color: var(--charcoal); color: var(--charcoal); }
        .page-btn.active { background: var(--charcoal); color: white; border-color: var(--charcoal); }
        .page-btn.disabled { opacity: 0.35; pointer-events: none; }

        /* ── Empty state ── */
        .empty-state { text-align: center; padding: 64px 20px; }
        .empty-state i { font-size: 2.5rem; color: var(--linen); margin-bottom: 16px; }
        .empty-state h4 { font-family: var(--font-serif); font-size: 1.3rem; margin-bottom: 8px; }
        .empty-state p { color: var(--grey); font-size: 0.9rem; }

        /* ── Responsive ── */
        @media (max-width: 767px) {
            .feat-grid { grid-template-columns: 1fr; }
            .feat-card.big { min-height: 300px; }
            .feat-card.sm  { min-height: 200px; }
            .coll-hero h1 { font-size: 2rem; }
        }
    </style>
</head>
<body class="quiet-luxury" style="background: var(--ivory);">
    <%- include('partials/header') %>

    <!-- Hero -->
    <section class="coll-hero">
        <span class="eyebrow">The Collection</span>
        <h1>Bringing luxury &amp; comfort to every room</h1>
        <p class="subtitle">Curated bedding, décor, vases, and art — every piece chosen to elevate how your home feels.</p>
    </section>

    <!-- Filter bar -->
    <div class="filter-bar">
        <div class="inner">
            <button class="ftab <%= (!filters.filter || filters.filter === 'all') ? 'active' : '' %>" onclick="setFilter('all')">All</button>
            <button class="ftab <%= filters.filter === 'bedding' ? 'active' : '' %>" onclick="setFilter('bedding')">Bedding</button>
            <button class="ftab <%= filters.filter === 'linen' ? 'active' : '' %>" onclick="setFilter('linen')">Linen</button>
            <button class="ftab <%= filters.filter === 'decor' ? 'active' : '' %>" onclick="setFilter('decor')">Décor</button>
            <button class="ftab <%= filters.filter === 'vases' ? 'active' : '' %>" onclick="setFilter('vases')">Vases</button>
            <button class="ftab <%= filters.filter === 'candles' ? 'active' : '' %>" onclick="setFilter('candles')">Candles</button>
            <button class="ftab <%= filters.filter === 'art' ? 'active' : '' %>" onclick="setFilter('art')">Wall art</button>
            <button class="ftab <%= filters.filter === 'accessories' ? 'active' : '' %>" onclick="setFilter('accessories')">Accessories</button>
        </div>
    </div>

    <main style="padding: 56px 0 80px;">
        <div class="container">

            <!-- ── FEATURED GRID (visible when filter = all) ── -->
            <% if (!filters.filter || filters.filter === 'all') { %>
            <%
                const fp = featuredProducts && featuredProducts.length > 0
                    ? featuredProducts
                    : (allProducts || []).sort((a,b) => b.price - a.price).slice(0,3);
                const [fp1, fp2, fp3] = fp;
            %>
            <div class="d-flex justify-content-between align-items-baseline mb-4">
                <div>
                    <span class="section-eyebrow">Curated picks</span>
                    <h2 class="section-title">Featured pieces</h2>
                </div>
                <a href="?filter=all#all-products" style="font-size:0.82rem;color:var(--grey);text-decoration:none;">View all &rarr;</a>
            </div>

            <div class="feat-grid">
                <% if (fp1) { %>
                <a href="/product/<%= fp1._id %>" class="feat-card big">
                    <div class="img-wrap">
                        <% if (fp1.images && fp1.images[0]) { %>
                            <img src="<%= fp1.images[0].url %>" alt="<%= fp1.name %>">
                        <% } else { %>
                            <div class="img-placeholder"><i class="fas fa-image fa-3x" style="color:#ccc;"></i></div>
                        <% } %>
                    </div>
                    <div class="card-label">
                        <div class="cat"><%= fp1.category %></div>
                        <div class="name"><%= fp1.name %></div>
                        <div class="price">₦<%= Number(fp1.discountPrice || fp1.price).toLocaleString() %></div>
                    </div>
                </a>
                <% } %>
                <% if (fp2) { %>
                <a href="/product/<%= fp2._id %>" class="feat-card sm">
                    <div class="img-wrap">
                        <% if (fp2.images && fp2.images[0]) { %>
                            <img src="<%= fp2.images[0].url %>" alt="<%= fp2.name %>">
                        <% } else { %>
                            <div class="img-placeholder"><i class="fas fa-image fa-2x" style="color:#ccc;"></i></div>
                        <% } %>
                    </div>
                    <div class="card-label">
                        <div class="cat"><%= fp2.category %></div>
                        <div class="name"><%= fp2.name %></div>
                        <div class="price">₦<%= Number(fp2.discountPrice || fp2.price).toLocaleString() %></div>
                    </div>
                </a>
                <% } %>
                <% if (fp3) { %>
                <a href="/product/<%= fp3._id %>" class="feat-card sm">
                    <div class="img-wrap">
                        <% if (fp3.images && fp3.images[0]) { %>
                            <img src="<%= fp3.images[0].url %>" alt="<%= fp3.name %>">
                        <% } else { %>
                            <div class="img-placeholder"><i class="fas fa-image fa-2x" style="color:#ccc;"></i></div>
                        <% } %>
                    </div>
                    <div class="card-label">
                        <div class="cat"><%= fp3.category %></div>
                        <div class="name"><%= fp3.name %></div>
                        <div class="price">₦<%= Number(fp3.discountPrice || fp3.price).toLocaleString() %></div>
                    </div>
                </a>
                <% } %>
            </div>
            <% } %>

            <!-- ── BEDDING COLLECTIONS STRIP (visible for all / bedding) ── -->
            <% if (!filters.filter || filters.filter === 'all' || filters.filter === 'bedding' || filters.filter === 'linen' || filters.filter === 'cotton') { %>
            <div class="d-flex justify-content-between align-items-baseline mb-4">
                <div>
                    <span class="section-eyebrow">Bedding</span>
                    <h2 class="section-title">Designed for deep rest</h2>
                </div>
                <button onclick="setFilter('bedding')" style="font-size:0.82rem;color:var(--grey);background:none;border:none;cursor:pointer;padding:0;">Browse all →</button>
            </div>

            <% if (beddingCollections && beddingCollections.length) { %>
            <div class="coll-strip">
                <% beddingCollections.forEach(c => { %>
                <a href="?filter=<%= c.slug %>" class="coll-strip-card">
                    <img src="<%= c.image %>" alt="<%= c.name %>" onerror="this.style.display='none'">
                    <div class="overlay">
                        <h4><%= c.name %></h4>
                        <p><%= c.description %> (<%= c.count %> pieces)</p>
                    </div>
                </a>
                <% }) %>
            </div>
            <% } %>

            <!-- Bedding products grid -->
            <div class="prod-grid mb-5">
                <% (beddingProducts || []).forEach(p => { %>
                <div class="prod-card">
                    <div class="prod-img">
                        <% if (p.images && p.images[0]) { %>
                            <img src="<%= p.images[0].url %>" alt="<%= p.name %>">
                        <% } else { %>
                            <div class="no-img"><i class="fas fa-image fa-2x" style="color:#ddd;"></i></div>
                        <% } %>
                    </div>
                    <div class="prod-info">
                        <div class="prod-cat"><%= p.category %></div>
                        <div class="prod-name"><%= p.name %></div>
                        <div class="prod-price">
                            ₦<%= Number(p.discountPrice || p.price).toLocaleString() %>
                            <% if (p.discountPrice) { %><span class="prod-original">₦<%= Number(p.price).toLocaleString() %></span><% } %>
                        </div>
                        <% if (p.specifications && (p.specifications.size || p.specifications.material)) { %>
                        <div class="prod-desc"><%= p.specifications.size || p.specifications.material %></div>
                        <% } %>
                        <button class="btn-add add-to-cart-btn" data-id="<%= p._id %>" <%= p.stock === 0 ? 'disabled' : '' %>>
                            <%= p.stock === 0 ? 'Out of stock' : '+ Add to cart' %>
                        </button>
                    </div>
                </div>
                <% }) %>
                <% if (!beddingProducts || beddingProducts.length === 0) { %>
                <div class="empty-state" style="grid-column:1/-1">
                    <i class="fas fa-bed"></i>
                    <h4>No bedding products found</h4>
                    <p>Check back soon.</p>
                </div>
                <% } %>
            </div>
            <% } %>

        </div>

        <!-- ── STORY BAND ── -->
        <% if (!filters.filter || filters.filter === 'all') { %>
        <div class="story-band">
            <div class="container">
                <div class="row align-items-center g-5">
                    <div class="col-lg-6">
                        <div class="story-img">
                            <i class="fas fa-image fa-3x" style="color:#ccc;"></i>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <span class="section-eyebrow">Our philosophy</span>
                        <h2 class="section-title mb-3">Comfort is the new luxury</h2>
                        <p style="color:var(--grey);line-height:1.8;margin-bottom:24px;">Every piece in our collection is chosen for one reason: the way it makes a room feel. Not just how it looks — but the warmth it adds, the calm it creates, the quiet confidence it brings to your home.</p>
                        <a href="/about" class="btn-cta-outline">Our story →</a>
                    </div>
                </div>
            </div>
        </div>
        <% } %>

        <div class="container" id="all-products">

            <!-- ── DÉCOR SECTION ── -->
            <% if (!filters.filter || filters.filter === 'all' || filters.filter === 'decor' || filters.filter === 'vases' || filters.filter === 'candles' || filters.filter === 'art') { %>

            <div class="d-flex justify-content-between align-items-baseline mb-4 mt-2">
                <div>
                    <span class="section-eyebrow">Décor</span>
                    <h2 class="section-title">Small details. Big difference.</h2>
                </div>
                <button onclick="setFilter('decor')" style="font-size:0.82rem;color:var(--grey);background:none;border:none;cursor:pointer;padding:0;">Browse all →</button>
            </div>

            <!-- Décor category cards -->
            <% if (decorCategories && decorCategories.length) { %>
            <div class="decor-cat-grid">
                <% decorCategories.forEach(c => { %>
                <a href="?filter=<%= c.slug %>" class="decor-cat-card">
                    <div class="dc-icon"><i class="fas <%= c.icon %>"></i></div>
                    <div class="dc-name"><%= c.name %></div>
                    <div class="dc-count"><%= c.count %> items</div>
                </a>
                <% }) %>
            </div>
            <% } %>

            <!-- Vases -->
            <% if (vaseProducts && vaseProducts.length && (!filters.filter || filters.filter === 'all' || filters.filter === 'decor' || filters.filter === 'vases')) { %>
            <div class="d-flex justify-content-between align-items-baseline mb-3 mt-4">
                <h3 style="font-family:var(--font-serif);font-size:1.2rem;font-weight:400;">Vases &amp; vessels</h3>
                <button onclick="setFilter('vases')" style="font-size:0.82rem;color:var(--grey);background:none;border:none;cursor:pointer;padding:0;">See all →</button>
            </div>
            <div class="prod-grid mb-5">
                <% vaseProducts.forEach(p => { %>
                <div class="prod-card">
                    <div class="prod-img">
                        <% if (p.images && p.images[0]) { %><img src="<%= p.images[0].url %>" alt="<%= p.name %>">
                        <% } else { %><div class="no-img"><i class="fas fa-image fa-2x" style="color:#ddd;"></i></div><% } %>
                    </div>
                    <div class="prod-info">
                        <div class="prod-cat">Vases</div>
                        <div class="prod-name"><%= p.name %></div>
                        <div class="prod-price">₦<%= Number(p.discountPrice || p.price).toLocaleString() %></div>
                        <div class="prod-desc"><%= p.description ? p.description.substring(0,65) + '...' : '' %></div>
                        <button class="btn-add add-to-cart-btn" data-id="<%= p._id %>" <%= p.stock === 0 ? 'disabled' : '' %>>+ Add to cart</button>
                    </div>
                </div>
                <% }) %>
            </div>
            <% } %>

            <!-- Candles -->
            <% if (candleProducts && candleProducts.length && (!filters.filter || filters.filter === 'all' || filters.filter === 'decor' || filters.filter === 'candles')) { %>
            <div class="d-flex justify-content-between align-items-baseline mb-3 mt-4">
                <h3 style="font-family:var(--font-serif);font-size:1.2rem;font-weight:400;">Scented candles &amp; diffusers</h3>
                <button onclick="setFilter('candles')" style="font-size:0.82rem;color:var(--grey);background:none;border:none;cursor:pointer;padding:0;">See all →</button>
            </div>
            <div class="prod-grid mb-5">
                <% candleProducts.forEach(p => { %>
                <div class="prod-card">
                    <div class="prod-img">
                        <% if (p.images && p.images[0]) { %><img src="<%= p.images[0].url %>" alt="<%= p.name %>">
                        <% } else { %><div class="no-img"><i class="fas fa-image fa-2x" style="color:#ddd;"></i></div><% } %>
                    </div>
                    <div class="prod-info">
                        <div class="prod-cat">Candles</div>
                        <div class="prod-name"><%= p.name %></div>
                        <div class="prod-price">₦<%= Number(p.discountPrice || p.price).toLocaleString() %></div>
                        <div class="prod-desc"><%= p.specifications && p.specifications.scent ? p.specifications.scent : (p.description ? p.description.substring(0,50) : '') %></div>
                        <button class="btn-add add-to-cart-btn" data-id="<%= p._id %>" <%= p.stock === 0 ? 'disabled' : '' %>>+ Add to cart</button>
                    </div>
                </div>
                <% }) %>
            </div>
            <% } %>

            <!-- Wall art -->
            <% if (artProducts && artProducts.length && (!filters.filter || filters.filter === 'all' || filters.filter === 'decor' || filters.filter === 'art')) { %>
            <div class="d-flex justify-content-between align-items-baseline mb-3 mt-4">
                <h3 style="font-family:var(--font-serif);font-size:1.2rem;font-weight:400;">Wall art prints</h3>
                <button onclick="setFilter('art')" style="font-size:0.82rem;color:var(--grey);background:none;border:none;cursor:pointer;padding:0;">See all →</button>
            </div>
            <div class="prod-grid mb-5">
                <% artProducts.forEach(p => { %>
                <div class="prod-card">
                    <div class="prod-img">
                        <% if (p.images && p.images[0]) { %><img src="<%= p.images[0].url %>" alt="<%= p.name %>">
                        <% } else { %><div class="no-img"><i class="fas fa-image fa-2x" style="color:#ddd;"></i></div><% } %>
                    </div>
                    <div class="prod-info">
                        <div class="prod-cat">Wall art</div>
                        <div class="prod-name">"<%= p.name %>"</div>
                        <div class="prod-price">₦<%= Number(p.discountPrice || p.price).toLocaleString() %></div>
                        <div class="prod-desc">by <%= (p.specifications && p.specifications.artist) || 'UZYHOMES' %></div>
                        <button class="btn-add add-to-cart-btn" data-id="<%= p._id %>" <%= p.stock === 0 ? 'disabled' : '' %>>+ Add to cart</button>
                    </div>
                </div>
                <% }) %>
            </div>
            <% } %>

            <% } %> <%/* end décor section */%>

            <!-- ── STYLING TIPS ── -->
            <% if (!filters.filter || filters.filter === 'all' || filters.filter === 'decor') { %>
            <section style="padding: 40px 0 56px;">
                <div class="row mb-4">
                    <div class="col-lg-8 mx-auto text-center">
                        <span class="section-eyebrow">Inspiration</span>
                        <h2 class="section-title">Décor styling tips</h2>
                    </div>
                </div>
                <div class="row g-4">
                    <% (stylingTips || []).forEach(tip => { %>
                    <div class="col-md-4">
                        <div class="tip-card">
                            <div class="tip-number"><%= tip.number %></div>
                            <h4><%= tip.title %></h4>
                            <p><%= tip.description %></p>
                        </div>
                    </div>
                    <% }) %>
                </div>
            </section>
            <% } %>

            <!-- ── ALL PRODUCTS (paginated, filtered) ── -->
            <% if (filters.filter && filters.filter !== 'all') { %>
            <div class="sort-wrap">
                <div class="dropdown">
                    <button class="sort-btn dropdown-toggle" data-bs-toggle="dropdown">
                        Sort:
                        <% if (filters.sort === 'price_low') { %>Price: Low–High
                        <% } else if (filters.sort === 'price_high') { %>Price: High–Low
                        <% } else if (filters.sort === 'newest') { %>Newest
                        <% } else if (filters.sort === 'rating') { %>Highest rated
                        <% } else { %>Featured<% } %>
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="?filter=<%= filters.filter %>&sort=featured">Featured</a></li>
                        <li><a class="dropdown-item" href="?filter=<%= filters.filter %>&sort=newest">Newest</a></li>
                        <li><a class="dropdown-item" href="?filter=<%= filters.filter %>&sort=price_low">Price: Low–High</a></li>
                        <li><a class="dropdown-item" href="?filter=<%= filters.filter %>&sort=price_high">Price: High–Low</a></li>
                    </ul>
                </div>
            </div>

            <div class="prod-grid">
                <% if (allProducts && allProducts.length > 0) { %>
                    <% allProducts.forEach(p => { %>
                    <div class="prod-card">
                        <div class="prod-img">
                            <% if (p.images && p.images[0]) { %>
                                <img src="<%= p.images[0].url %>" alt="<%= p.name %>">
                            <% } else { %>
                                <div class="no-img"><i class="fas fa-image fa-2x" style="color:#ddd;"></i></div>
                            <% } %>
                        </div>
                        <div class="prod-info">
                            <div class="prod-cat"><%= p.category %></div>
                            <div class="prod-name"><%= p.name %></div>
                            <div class="prod-price">
                                ₦<%= Number(p.discountPrice || p.price).toLocaleString() %>
                                <% if (p.discountPrice) { %><span class="prod-original">₦<%= Number(p.price).toLocaleString() %></span><% } %>
                            </div>
                            <div class="prod-desc"><%= p.description ? p.description.substring(0,70) + '...' : '' %></div>
                            <button class="btn-add add-to-cart-btn" data-id="<%= p._id %>" <%= p.stock === 0 ? 'disabled' : '' %>>
                                <%= p.stock === 0 ? 'Out of stock' : '+ Add to cart' %>
                            </button>
                        </div>
                    </div>
                    <% }) %>
                <% } else { %>
                    <div class="empty-state" style="grid-column:1/-1">
                        <i class="fas fa-box-open"></i>
                        <h4>No products found</h4>
                        <p>Try a different filter or check back soon.</p>
                        <button class="btn-cta-outline" onclick="setFilter('all')" style="margin-top:16px;">View all products</button>
                    </div>
                <% } %>
            </div>

            <!-- Pagination -->
            <% if (pagination && pagination.totalPages > 1) { %>
            <div class="pagination-wrap">
                <% if (pagination.hasPrev) { %>
                    <a class="page-btn" href="?filter=<%= filters.filter %>&sort=<%= filters.sort %>&page=<%= pagination.prevPage %>">&lsaquo;</a>
                <% } else { %>
                    <span class="page-btn disabled">&lsaquo;</span>
                <% } %>
                <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                    <% if (i === 1 || i === pagination.totalPages || (i >= pagination.currentPage - 1 && i <= pagination.currentPage + 1)) { %>
                        <a class="page-btn <%= i === pagination.currentPage ? 'active' : '' %>"
                           href="?filter=<%= filters.filter %>&sort=<%= filters.sort %>&page=<%= i %>"><%= i %></a>
                    <% } else if (i === pagination.currentPage - 2 || i === pagination.currentPage + 2) { %>
                        <span class="page-btn disabled">…</span>
                    <% } %>
                <% } %>
                <% if (pagination.hasNext) { %>
                    <a class="page-btn" href="?filter=<%= filters.filter %>&sort=<%= filters.sort %>&page=<%= pagination.nextPage %>">&rsaquo;</a>
                <% } else { %>
                    <span class="page-btn disabled">&rsaquo;</span>
                <% } %>
            </div>
            <% } %>
            <% } %> <%/* end filtered products */%>

        </div>
    </main>

    <!-- CTA -->
    <section class="cta-section">
        <div class="container">
            <h2>Ready to transform your space?</h2>
            <p>Whether you're looking for bedding, décor, or a complete interior transformation, we're here to help.</p>
            <div class="d-flex gap-3 justify-content-center flex-wrap">
                <a href="/contact" class="btn-cta-dark">Book consultation</a>
                <a href="/interiors" class="btn-cta-outline">View interiors</a>
            </div>
        </div>
    </section>

    <%- include('partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/auth.js"></script>
    <script src="/js/cart.js"></script>
    <script>
        function setFilter(f) {
            const url = new URL(window.location.href);
            url.searchParams.set('filter', f);
            url.searchParams.delete('page');
            window.location.href = url.toString();
        }

        // Sync filter bar tabs with current URL on load
        document.addEventListener('DOMContentLoaded', () => {
            const params = new URLSearchParams(window.location.search);
            const active = params.get('filter') || 'all';
            document.querySelectorAll('.ftab').forEach(btn => {
                const f = btn.getAttribute('onclick').match(/'([^']+)'/)?.[1];
                btn.classList.toggle('active', f === active);
            });
        });
    </script>
</body>
</html>
