<%# views/search.ejs %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Search UZYHOMES — Find bedding, décor, furniture, blog posts and more.">
    <title>Search Results<%= query ? ` for "${query}"` : '' %> — UZYHOMES</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">

    <style>
        :root {
            --ivory: #FAF9F7;
            --stone: #F5F3F0;
            --sand: #E8E4DD;
            --charcoal: #2D2D2D;
            --grey: #777777;
            --clay: #A68A6F;
            --linen: #D9D1C7;
            --font-serif: 'Playfair Display', Georgia, serif;
            --font-sans: 'Inter', sans-serif;
            --ease: all 0.3s cubic-bezier(0.4,0,0.2,1);
        }

        body { font-family: var(--font-sans); font-weight: 300; color: var(--charcoal); background: var(--ivory); }

        /* ── Hero ── */
        .search-page-hero {
            padding: 120px 0 48px;
            background: linear-gradient(to bottom, var(--stone), var(--ivory));
        }
        .search-page-hero h1 {
            font-family: var(--font-serif);
            font-size: clamp(1.6rem, 4vw, 2.8rem);
            font-weight: 400;
            margin-bottom: 8px;
        }
        .search-page-hero .result-count {
            font-size: 0.9rem;
            color: var(--grey);
        }
        .search-page-hero .result-count strong { color: var(--charcoal); }

        /* ── Search Bar ── */
        .search-bar-wrap {
            position: relative;
            max-width: 640px;
            margin: 28px 0 0;
        }
        .search-bar-wrap input {
            width: 100%;
            padding: 14px 56px 14px 20px;
            font-size: 1rem;
            border: 1px solid var(--sand);
            border-radius: 40px;
            background: white;
            outline: none;
            font-family: var(--font-sans);
            transition: var(--ease);
        }
        .search-bar-wrap input:focus { border-color: var(--charcoal); box-shadow: 0 0 0 3px rgba(45,45,45,0.06); }
        .search-bar-wrap button {
            position: absolute;
            right: 6px;
            top: 50%;
            transform: translateY(-50%);
            width: 44px;
            height: 44px;
            border-radius: 50%;
            border: none;
            background: var(--charcoal);
            color: white;
            cursor: pointer;
            transition: var(--ease);
        }
        .search-bar-wrap button:hover { background: #444; }

        /* ── Filter Tabs ── */
        .filter-tabs {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin: 32px 0 24px;
        }
        .filter-tab {
            padding: 8px 20px;
            border: 1px solid var(--sand);
            background: white;
            border-radius: 40px;
            font-size: 0.85rem;
            cursor: pointer;
            transition: var(--ease);
            text-decoration: none;
            color: var(--grey);
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .filter-tab:hover, .filter-tab.active {
            border-color: var(--charcoal);
            background: var(--charcoal);
            color: white;
        }
        .filter-tab .count {
            background: rgba(255,255,255,0.25);
            border-radius: 20px;
            padding: 1px 8px;
            font-size: 0.75rem;
        }
        .filter-tab.active .count { background: rgba(255,255,255,0.25); }
        .filter-tab:not(.active) .count { background: var(--stone); color: var(--grey); }

        /* ── Result Cards ── */
        .results-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 24px;
            padding-bottom: 60px;
        }

        .result-card {
            background: white;
            border: 1px solid rgba(0,0,0,0.05);
            border-radius: 12px;
            overflow: hidden;
            text-decoration: none;
            color: var(--charcoal);
            transition: var(--ease);
            display: flex;
            flex-direction: column;
        }
        .result-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 32px rgba(0,0,0,0.08);
            text-decoration: none;
            color: var(--charcoal);
        }

        .result-image {
            aspect-ratio: 4/3;
            background: var(--stone);
            overflow: hidden;
            position: relative;
        }
        .result-image img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
        .result-card:hover .result-image img { transform: scale(1.04); }
        .result-image-placeholder {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--linen);
            font-size: 2.5rem;
        }

        .result-type-badge {
            position: absolute;
            top: 12px;
            left: 12px;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.7rem;
            letter-spacing: 0.5px;
            font-weight: 500;
            text-transform: uppercase;
        }
        .badge-product { background: var(--charcoal); color: white; }
        .badge-blog    { background: var(--clay);     color: white; }
        .badge-page    { background: var(--linen);    color: var(--charcoal); }

        .result-body { padding: 18px; flex: 1; display: flex; flex-direction: column; }
        .result-subtitle { font-size: 0.72rem; letter-spacing: 1.5px; text-transform: uppercase; color: var(--clay); margin-bottom: 6px; }
        .result-title { font-size: 1rem; font-weight: 500; margin-bottom: 6px; line-height: 1.3; }
        .result-desc { font-size: 0.85rem; color: var(--grey); line-height: 1.6; flex: 1; }
        .result-footer { margin-top: 12px; display: flex; align-items: center; justify-content: space-between; }
        .result-price { font-size: 1rem; font-weight: 500; color: var(--charcoal); }
        .result-price .original { font-size: 0.8rem; color: var(--grey); text-decoration: line-through; margin-left: 6px; }
        .result-date { font-size: 0.78rem; color: var(--grey); }
        .out-of-stock { font-size: 0.75rem; color: #c0392b; margin-top: 4px; }

        /* ── Empty State ── */
        .no-results {
            text-align: center;
            padding: 80px 20px;
            grid-column: 1 / -1;
        }
        .no-results i { font-size: 3rem; color: var(--linen); margin-bottom: 20px; }
        .no-results h3 { font-family: var(--font-serif); font-weight: 400; margin-bottom: 10px; }
        .no-results p { color: var(--grey); max-width: 400px; margin: 0 auto 28px; }
        .suggestions { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
        .suggestion-chip {
            padding: 8px 18px;
            background: white;
            border: 1px solid var(--sand);
            border-radius: 40px;
            font-size: 0.85rem;
            text-decoration: none;
            color: var(--grey);
            transition: var(--ease);
        }
        .suggestion-chip:hover { border-color: var(--charcoal); color: var(--charcoal); }

        /* ── Loading ── */
        .loading-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(250,249,247,0.7);
            backdrop-filter: blur(4px);
            z-index: 999;
            align-items: center;
            justify-content: center;
        }
        .loading-overlay.active { display: flex; }
        .loader {
            width: 40px;
            height: 40px;
            border: 3px solid var(--sand);
            border-top-color: var(--charcoal);
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }
        @keyframes spin { to { transform: rotate(360deg); } }

        /* ── Pagination ── */
        .pagination-wrap {
            display: flex;
            justify-content: center;
            gap: 8px;
            padding: 20px 0 60px;
        }
        .page-btn {
            width: 40px;
            height: 40px;
            border: 1px solid var(--sand);
            background: white;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 0.9rem;
            color: var(--grey);
            text-decoration: none;
            transition: var(--ease);
        }
        .page-btn:hover { border-color: var(--charcoal); color: var(--charcoal); }
        .page-btn.active { background: var(--charcoal); color: white; border-color: var(--charcoal); }

        @media (max-width: 576px) {
            .results-grid { grid-template-columns: 1fr; }
            .filter-tabs { gap: 6px; }
            .filter-tab { padding: 7px 14px; font-size: 0.78rem; }
        }
    </style>
</head>
<body>
    <%- include('partials/header') %>

    <div class="loading-overlay" id="loadingOverlay"><div class="loader"></div></div>

    <!-- Hero -->
    <section class="search-page-hero">
        <div class="container">
            <h1 id="heroTitle">
                <% if (query) { %>
                    Results for <em>"<%= query %>"</em>
                <% } else { %>
                    Search UZYHOMES
                <% } %>
            </h1>
            <p class="result-count" id="resultCount">
                <% if (typeof total !== 'undefined') { %>
                    <strong><%= total %></strong> result<%= total !== 1 ? 's' : '' %> found
                <% } %>
            </p>

            <div class="search-bar-wrap">
                <input type="text" id="pageSearchInput" placeholder="Search products, blog posts, pages…"
                       value="<%= query || '' %>" autocomplete="off">
                <button onclick="doSearch()"><i class="fas fa-search"></i></button>
            </div>
        </div>
    </section>

    <!-- Filters + Results -->
    <div class="container">
        <div class="filter-tabs" id="filterTabs">
            <button class="filter-tab active" data-type="all" onclick="setFilter('all', this)">
                All <span class="count" id="countAll">0</span>
            </button>
            <button class="filter-tab" data-type="products" onclick="setFilter('products', this)">
                <i class="fas fa-tag"></i> Products <span class="count" id="countProducts">0</span>
            </button>
            <button class="filter-tab" data-type="blog" onclick="setFilter('blog', this)">
                <i class="fas fa-newspaper"></i> Blog <span class="count" id="countBlog">0</span>
            </button>
            <button class="filter-tab" data-type="pages" onclick="setFilter('pages', this)">
                <i class="fas fa-file"></i> Pages <span class="count" id="countPages">0</span>
            </button>
        </div>

        <div class="results-grid" id="resultsGrid">
            <!-- Populated by JS -->
        </div>

        <div class="pagination-wrap" id="paginationWrap"></div>
    </div>

    <%- include('partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/auth.js"></script>
    <script src="/js/cart.js"></script>

    <script>
        const TYPE_ICONS = { Product: 'fa-tag', Blog: 'fa-newspaper', Page: 'fa-file' };
        const TYPE_PLACEHOLDER = { Product: '🛍', Blog: '📰', Page: '📄' };

        let currentQuery  = '<%= (query || "").replace(/'/g, "\\'") %>';
        let currentType   = 'all';
        let currentPage   = 1;
        let totalResults  = 0;
        let allResults    = [];

        /* ── Fetch ────────────────────────────────────────────────────────── */
        async function fetchResults(q, type = 'all', page = 1) {
            if (!q || q.trim().length < 2) {
                renderEmpty('Type at least 2 characters to search.');
                return;
            }

            showLoader(true);

            try {
                const url = `/api/search?q=${encodeURIComponent(q)}&type=${type}&page=${page}&limit=12`;
                const res = await fetch(url);
                const data = await res.json();

                if (!data.success) throw new Error(data.message);

                allResults   = data.results;
                totalResults = data.total;
                currentPage  = page;

                updateHero(q, data.total);
                updateCounts(data.results);
                renderResults(data.results);
                renderPagination(page, data.pages);

            } catch (err) {
                console.error('Search error:', err);
                renderEmpty('Something went wrong. Please try again.');
            } finally {
                showLoader(false);
            }
        }

        /* ── Counts update ──────────────────────────────────────────────── */
        function updateCounts(results) {
            const counts = results.reduce((acc, r) => { acc[r.type] = (acc[r.type] || 0) + 1; return acc; }, {});
            document.getElementById('countAll').textContent      = results.length;
            document.getElementById('countProducts').textContent = counts.Product || 0;
            document.getElementById('countBlog').textContent     = counts.Blog    || 0;
            document.getElementById('countPages').textContent    = counts.Page    || 0;
        }

        /* ── Render ─────────────────────────────────────────────────────── */
        function renderResults(results) {
            const grid = document.getElementById('resultsGrid');

            if (!results || results.length === 0) {
                renderEmpty();
                return;
            }

            grid.innerHTML = results.map(r => buildCard(r)).join('');
        }

        function buildCard(r) {
            const badgeClass = { Product: 'badge-product', Blog: 'badge-blog', Page: 'badge-page' }[r.type] || 'badge-page';
            const imgHtml = r.image
                ? `<img src="${r.image}" alt="${escHtml(r.title)}" loading="lazy">`
                : `<div class="result-image-placeholder">${TYPE_PLACEHOLDER[r.type] || '🔍'}</div>`;

            let footer = '';
            if (r.type === 'Product') {
                footer = `<div class="result-footer">
                    <span class="result-price">₦${Number(r.price).toLocaleString()}${r.originalPrice ? `<span class="original">₦${Number(r.originalPrice).toLocaleString()}</span>` : ''}</span>
                    ${!r.inStock ? '<span class="out-of-stock"><i class="fas fa-times-circle"></i> Out of stock</span>' : ''}
                </div>`;
            } else if (r.type === 'Blog' && r.date) {
                footer = `<div class="result-footer"><span class="result-date">${new Date(r.date).toLocaleDateString('en-US', { year:'numeric', month:'short', day:'numeric' })}</span></div>`;
            }

            return `<a href="${r.url}" class="result-card">
                <div class="result-image">
                    ${imgHtml}
                    <span class="result-type-badge ${badgeClass}">${r.type}</span>
                </div>
                <div class="result-body">
                    <div class="result-subtitle">${escHtml(r.subtitle || '')}</div>
                    <div class="result-title">${highlight(escHtml(r.title), currentQuery)}</div>
                    ${r.description ? `<div class="result-desc">${highlight(escHtml(r.description), currentQuery)}</div>` : ''}
                    ${footer}
                </div>
            </a>`;
        }

        function renderEmpty(msg) {
            document.getElementById('resultsGrid').innerHTML = `
                <div class="no-results">
                    <i class="fas fa-search"></i>
                    <h3>${msg || `No results for "${currentQuery}"`}</h3>
                    <p>Try different keywords or explore our collections.</p>
                    <div class="suggestions">
                        <a href="/bedding"   class="suggestion-chip">Bedding</a>
                        <a href="/decor"     class="suggestion-chip">Décor</a>
                        <a href="/furniture" class="suggestion-chip">Furniture</a>
                        <a href="/interiors" class="suggestion-chip">Interiors</a>
                        <a href="/blog"      class="suggestion-chip">Blog</a>
                    </div>
                </div>`;
            document.getElementById('paginationWrap').innerHTML = '';
        }

        /* ── Pagination ─────────────────────────────────────────────────── */
        function renderPagination(page, pages) {
            const wrap = document.getElementById('paginationWrap');
            if (!pages || pages <= 1) { wrap.innerHTML = ''; return; }

            let html = '';
            if (page > 1) html += `<button class="page-btn" onclick="goPage(${page - 1})"><i class="fas fa-chevron-left"></i></button>`;

            for (let i = 1; i <= pages; i++) {
                if (i === 1 || i === pages || (i >= page - 2 && i <= page + 2)) {
                    html += `<button class="page-btn ${i === page ? 'active' : ''}" onclick="goPage(${i})">${i}</button>`;
                } else if (i === page - 3 || i === page + 3) {
                    html += `<span class="page-btn" style="cursor:default">…</span>`;
                }
            }

            if (page < pages) html += `<button class="page-btn" onclick="goPage(${page + 1})"><i class="fas fa-chevron-right"></i></button>`;
            wrap.innerHTML = html;
        }

        /* ── Helpers ────────────────────────────────────────────────────── */
        function highlight(text, q) {
            if (!q || q.length < 2) return text;
            const escaped = q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            return text.replace(new RegExp(`(${escaped})`, 'gi'), '<mark style="background:#fff3cd;padding:0 2px;border-radius:2px">$1</mark>');
        }

        function escHtml(str) {
            const map = { '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;' };
            return String(str).replace(/[&<>"']/g, m => map[m]);
        }

        function updateHero(q, total) {
            document.getElementById('heroTitle').innerHTML = q
                ? `Results for <em>"${escHtml(q)}"</em>`
                : 'Search UZYHOMES';
            document.getElementById('resultCount').innerHTML =
                `<strong>${total}</strong> result${total !== 1 ? 's' : ''} found`;
        }

        function showLoader(show) {
            document.getElementById('loadingOverlay').classList.toggle('active', show);
        }

        /* ── Interactions ───────────────────────────────────────────────── */
        function doSearch() {
            const q = document.getElementById('pageSearchInput').value.trim();
            if (!q) return;
            currentQuery = q;
            currentType  = 'all';
            currentPage  = 1;

            // Update active tab
            document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
            document.querySelector('[data-type="all"]').classList.add('active');

            history.replaceState(null, '', `/search?q=${encodeURIComponent(q)}`);
            fetchResults(q);
        }

        function setFilter(type, btn) {
            currentType = type;
            currentPage = 1;
            document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
            btn.classList.add('active');
            fetchResults(currentQuery, type, 1);
        }

        function goPage(page) {
            currentPage = page;
            window.scrollTo({ top: 300, behavior: 'smooth' });
            fetchResults(currentQuery, currentType, page);
        }

        /* ── Enter key ── */
        document.getElementById('pageSearchInput').addEventListener('keydown', e => {
            if (e.key === 'Enter') doSearch();
        });

        /* ── Init ── */
        if (currentQuery) {
            fetchResults(currentQuery, currentType, 1);
        } else {
            document.getElementById('resultsGrid').innerHTML = `
                <div class="no-results">
                    <i class="fas fa-search"></i>
                    <h3>What are you looking for?</h3>
                    <p>Search for products, blog posts, or browse our collections.</p>
                    <div class="suggestions">
                        <a href="/bedding"   class="suggestion-chip">Bedding</a>
                        <a href="/decor"     class="suggestion-chip">Décor</a>
                        <a href="/furniture" class="suggestion-chip">Furniture</a>
                        <a href="/interiors" class="suggestion-chip">Interiors</a>
                        <a href="/blog"      class="suggestion-chip">Blog</a>
                    </div>
                </div>`;
        }
    </script>
</body>
</html>
